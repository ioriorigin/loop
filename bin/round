#!/usr/bin/env bash
# 発火台帳。**起きた瞬間に1行書く。締めのときではない。**
#   ./bin/round open [メモ]    起動直後に呼ぶ。この回が起きた事実を確定させる
#   ./bin/round close [メモ]   締めに呼ぶ。直近の open との差＝その回の所要時間を記録する
#   ./bin/round list           記録された発火を並べる
#   ./bin/round gaps [時間]    期待間隔より広い空白＝見ていない発火を検出する
#   ./bin/round times [件数]   直近の回の所要時間を並べる（回の「内側」の長さを見る）
#
# なぜ「起きた瞬間」なのか。
# 締めのときに書く設計は、その回が途中で死ぬと1行も残さない。2026-08-30 に4回それで全損した。
# 記録は、失われうる作業の**前**に置く。橋頭堡 push と同じ原理をここにも適用する。
#
# なぜ台帳が要るのか。
# 停止条件「薄い回が3回連続したら頻度を下げる」のカウンタが手動だった。
# 「見ていない回は数えられず、数えられない回は停止条件を素通りする」（第2回診断）。
# 発火が機械的に並べば、抜けた回は間隔の空白として自動的に浮かぶ。
#
# なぜ close と times を後から足したのか（2026-09-02 / 第3回診断の盲点1）。
# gaps は「回と回の**間**」の空白しか見ていなかった。回の**内側**は誰も測っていない。
# 実際 09-01 の回は 12:45 に open してから 21:24 まで8時間39分、記録を1行も残していない。
# それでも gaps は「見落とした発火は無い」と答える。間隔はちょうど12時間だからである。
# **8時間41分の回と8分45秒の回が、同じ「1回」として並んでいる限り、コストも密度も見えない。**
# open が epoch を持っているのだから、close との差を書けば、次の自分の recall に自動的に突きつけられる。
#
# 【重要】close 行を足すときの落とし穴。
# list / gaps は「epoch= を持つ行」を発火として数える。close 行をそのまま足すと**発火が二重に数えられ、
# 間隔が半分に見え、空白検出が黙って壊れる。** 計器を足したつもりで計器を壊すのは、この repo が
# 何度も踏んだ型である（mtime 判定の checkpoint、出現順の畳み込み）。
# だから close 行には ` close ` の印を必ず入れ、発火として数える箇所では明示的に除外する。
# 印の無い過去の行はすべて open である（後方互換）。selftest でこの両方向を覆っている。
source "$(dirname "$0")/_common.sh"

F="$MEM/rounds.md"
DEFAULT_INTERVAL_H=12

[ -f "$F" ] || printf '# 発火台帳\n\n追記のみ。起動した瞬間に1行書く。締めのときではない。\n空白は `./bin/round gaps` で検出する。\n' > "$F"

case "${1:-list}" in
  open)
    note="${2:-}"
    printf -- '\n- `%s` epoch=%s %s\n' "$(ts_both)" "$(date -u +%s)" "$note" >> "$F"
    echo "round opened -> ${F#"$ROOT/"}"
    ;;
  close)
    note="${2:-}"
    # 直近の open（close 印の無い epoch 行）を探す。無ければ何も測れないので素直にそう言う。
    last_open=$(grep -E '^- `.*epoch=' "$F" 2>/dev/null | grep -v ' close ' | tail -1)
    if [ -z "$last_open" ]; then
      echo "round close: 対応する open が無い。所要時間は測れない" >&2
      exit 1
    fi
    o=$(sed -E 's/.*epoch=([0-9]+).*/\1/' <<<"$last_open")
    now=$(date -u +%s)
    d=$((now - o))
    [ "$d" -lt 0 ] && d=0
    dur="$((d/3600))h$(( (d%3600)/60 ))m"
    printf -- '\n- `%s` epoch=%s close dur=%s elapsed_s=%s %s\n' "$(ts_both)" "$now" "$dur" "$d" "$note" >> "$F"
    echo "round closed（所要 $dur） -> ${F#"$ROOT/"}"
    ;;
  times)
    n="${2:-5}"
    # open と close を突き合わせて、直近の回の所要時間を並べる。
    # 「回が起きたこと」ではなく「回がどれだけ走ったか」を見るための計器。
    grep -E '^- `.*epoch=' "$F" 2>/dev/null | awk -v want="$n" '
      {
        lab = $0
        if (match(lab, /`[^`]+`/)) lab = substr(lab, RSTART+1, RLENGTH-2)
        is_close = ($0 ~ / close /)
        if (!match($0, /epoch=[0-9]+/)) next
        e = substr($0, RSTART+6, RLENGTH-6) + 0
        if (is_close) {
          if (open_e > 0) { n_rec++; rec[n_rec] = sprintf("  %s → %s  所要 %.1f 時間", olab, lab, (e-open_e)/3600); open_e = 0 }
        } else {
          if (open_e > 0) { n_rec++; rec[n_rec] = sprintf("  %s  ** close されずに次の回が始まった **", olab) }
          open_e = e; olab = lab
        }
      }
      END {
        if (open_e > 0) { n_rec++; rec[n_rec] = sprintf("  %s  （この回。まだ close されていない）", olab) }
        if (n_rec == 0) { print "  (所要時間の記録なし)"; exit }
        start = n_rec - want + 1; if (start < 1) start = 1
        for (i = start; i <= n_rec; i++) print rec[i]
      }
    '
    ;;
  list)
    grep -E '^- `.*epoch=' "$F" || echo "(発火の記録なし)"
    ;;
  gaps)
    h="${2:-$DEFAULT_INTERVAL_H}"
    # close 行は発火ではない。数えると間隔が半分に見え、空白検出が黙って壊れる。
    grep -E '^- `.*epoch=' "$F" 2>/dev/null | grep -v ' close ' | awk -v maxgap="$((h*3600))" -v ih="$h" '
      {
        # 表示用のラベル（最初のバッククォート内）と epoch を取り出す
        lab = $0
        if (match(lab, /`[^`]+`/)) lab = substr(lab, RSTART+1, RLENGTH-2)
        if (!match($0, /epoch=[0-9]+/)) next
        e = substr($0, RSTART+6, RLENGTH-6) + 0
        if (prev > 0 && e - prev > maxgap * 1.5) {
          printf "  [空白] %.1f 時間あいている（期待 %s 時間）: %s → %s\n", (e-prev)/3600, ih, plab, lab
          n++
        }
        prev = e; plab = lab; c++
      }
      END {
        if (c == 0) { print "  (発火の記録なし)"; exit }
        if (n == 0) printf "  記録された発火 %d 件。見落とした発火は無い（期待間隔 %s 時間）\n", c, ih
        else        printf "  ** %d 箇所の空白。見ていない発火がある可能性が高い **\n", n
      }
    '
    ;;
  *) echo "usage: round {open|close|list|gaps|times}" >&2; exit 2 ;;
esac
