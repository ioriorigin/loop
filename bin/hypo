#!/usr/bin/env bash
# 仮説台帳。追記のみで状態を表現する。過去の記述は絶対に書き換えない。
#   ./bin/hypo add "仮説"                     -> 新しい仮説を立てる
#   ./bin/hypo close H003 verified "根拠"     -> 検証して決着させる (verified|refuted|dropped)
#   ./bin/hypo list                           -> 未決着の仮説を一覧する
#   ./bin/hypo all                            -> 全履歴を出す
source "$(dirname "$0")/_common.sh"

F="$MEM/hypotheses.md"
mkdir -p "$(dirname "$F")"
[ -f "$F" ] || printf '# 仮説台帳\n\n追記のみ。決着した仮説も消さない。外れた仮説こそが次の一手の材料になる。\n' > "$F"

# 並行して走る別セッションが同時に採番すると、連番だけでは同じ ID を別の仮説に振ってしまう。
# 2026-08-30 に実際に発生し、H009/H010/H011 が二重に使われて台帳の畳み込みが壊れた。
# 連番は読みやすさのために残し、衝突しない乱数の接尾辞を付けて一意性を担保する。
next_id() {
  local n suffix
  n=$(grep -oE '^- id: H[0-9]{3}' "$F" | grep -oE '[0-9]{3}$' | sort -n | tail -1)
  suffix=$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n' | cut -c1-3)
  printf 'H%03d-%s' $(( 10#${n:-0} + 1 )) "$suffix"
}

case "${1:-list}" in
  add)
    text="${2:?usage: hypo add <text>}"
    id="$(next_id)"
    {
      printf -- '\n- id: %s\n' "$id"
      printf -- '  - `%s` **open** %s\n' "$(ts_both)" "$text"
    } >> "$F"
    echo "$id"
    ;;
  close)
    id="${2:?usage: hypo close <ID> <verified|refuted|dropped> <evidence>}"
    verdict="${3:?verdict required}"
    evidence="${4:-}"
    grep -q "^- id: $id$" "$F" || { echo "no such hypothesis: $id" >&2; exit 1; }
    {
      printf -- '\n- id: %s\n' "$id"
      printf -- '  - `%s` **%s** %s\n' "$(ts_both)" "$verdict" "$evidence"
    } >> "$F"
    echo "$id -> $verdict"
    ;;
  annotate)
    # 決着させずに所見を追記する。検証条件が変わった / 検証不能になった場合に使う。
    id="${2:?usage: hypo annotate <ID> <text>}"
    text="${3:?text required}"
    grep -q "^- id: $id$" "$F" || { echo "no such hypothesis: $id" >&2; exit 1; }
    {
      printf -- '\n- id: %s\n' "$id"
      printf -- '  - `%s` **open** %s\n' "$(ts_both)" "$text"
    } >> "$F"
    echo "$id <- annotated"
    ;;
  list)
    # 追記されたイベントを走査して、最新の状態が open のものだけ残す。
    #
    # 「最新」をファイルの出現順で採ってはいけない。追記専用ファイルは .gitattributes の
    # merge=union で併合されるため、並行セッションが書いた**古いイベントが後ろに積まれる**。
    # 実際 2026-08-31、親セッションが 00:45:01 に書いた open が、こちらが 00:49:51 に書いた
    # verified より後ろに来て、**決着済みの H003 が open に蘇った。**
    # 決定を黙って取り消す台帳は、間違った台帳より質が悪い。だから時刻で畳み込む。
    #
    # 同時刻（同一秒）に別セッションが書いた場合だけは順序を決められないので、
    # >= にしてファイル出現順の後勝ちに落とす。そこは救えないと認めておく。
    awk '
      /^- id: H[0-9]+(-[0-9a-f]+)?$/ { id=$3; next }
      /^  - `/ {
        if (match($0, /\*\*[a-z]+\*\*/)) {
          st=substr($0, RSTART+2, RLENGTH-4)
          body=substr($0, RSTART+RLENGTH+1)
          # 行頭の `YYYY-MM-DD HH:MM:SS UTC` を取り出す。mawk は {n} を解さないので使わない。
          ts=""
          if (match($0, /`[0-9][0-9-]* [0-9][0-9:]* UTC/)) { ts=substr($0, RSTART+1, RLENGTH-5) }
          if (!(id in seen)) { order[++n]=id; seen[id]=1 }
          if (ts >= last[id]) { last[id]=ts; state[id]=st; txt[id]=body }
        }
      }
      END {
        c=0
        for (i=1;i<=n;i++) { id=order[i]; if (state[id]=="open") { printf "%s %s\n", id, txt[id]; c++ } }
        if (c==0) print "(未決着の仮説なし)"
      }
    ' "$F"
    ;;
  all) cat "$F" ;;
  *) echo "usage: hypo {add|close|annotate|list|all}" >&2; exit 2 ;;
esac
