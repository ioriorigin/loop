#!/usr/bin/env bash
# 原稿（商品そのもの）の数値主張が、リポジトリの実物と一致するかを測る。
#
# なぜ要るか（2026-09-13）。原稿の4章の脚注が、**再現できないコミット数を載せていた。**
# まえがき 78 / 第3章 109 / 第4章 116 / 第5章 82 —— 実測は 104 / 139 / 147 / 110 である。
# **原因は浅いクローンだった。** 定期発火のコンテナは `--depth` 付きで clone される
# （2026-09-13 に `git rev-parse --is-shallow-repository` が `true` を返して判明。
# unshallow したら main の累計が 195 → 243 に増えた）。
# `git rev-list --count` は**接ぎ木の境界で黙って止まる。エラーは出ない。**
#
# まえがきは「**本文がリポジトリと食い違っていたら、リポジトリのほうが正しい**」と書き、
# 読者に検算を勧めている。**その検算が合わない状態で売り物にしていた。**
#
# **この検査そのものが浅いクローンで赤くなってはいけない。**
# 浅いのは環境の既定であって欠陥ではない。良性の状態を緊急事態と読み違えると1回分を潰す
# （memory/OPERATING.md §3）。だから浅いときは「測れない」と言って 0 で抜ける。
#
# 使い方:
#   bin/bookcheck [原稿ディレクトリ]
#
# 終了コード:
#   0 = 全部一致（または浅くて測れない。**測れないことで赤くしない**）
#   1 = 再現できない数値がある／脚注の無い章がある

set -euo pipefail

DIR="${1:-venture/book/manuscript}"

if [ ! -d "$DIR" ]; then
  echo "原稿ディレクトリが無い: $DIR"
  exit 1
fi

fail=0
checked=0

# 脚注（いつ時点の数字かの断り書き）が全章にあるか。
# **これが無い章は、時が経つと「現在の事実」として読まれる。**
for f in "$DIR"/*.md; do
  if ! grep -q '時点' "$f"; then
    echo "  [NG] $(basename "$f"): いつ時点の数値かの断り書きが無い"
    fail=1
  fi
done

# コミット数の主張を、実物の git で検算する。
# 脚注の形式: 「コミット N 件」…「git rev-list --count <SHA>」
shallow=$(git rev-parse --is-shallow-repository 2>/dev/null || echo unknown)
if [ "$shallow" != "false" ]; then
  echo "  [--] クローンが浅い（is-shallow=$shallow）。コミット数は検算できない。"
  # **バッククォートを二重引用符の中に置くとコマンド置換になる。**
  # 初版はここに `git fetch --unshallow` と書いていて、浅い回に**実際に fetch を走らせていた。**
  # 検査が副作用を持つと、検査した瞬間に測っている対象が変わる。単引用符で書く。
  echo '       git fetch --unshallow してからもう一度叩くこと。**浅さは欠陥ではない。**'
else
  for f in "$DIR"/*.md; do
    # 章ごとに、主張された件数と、再現コマンドの SHA を1組ずつ拾う
    # 「コミット N 件」「コミット数は N 件」「N 個のコミット」の3通りを拾う。
    # **書き方が1つだと思い込むと、拾えなかった章が黙って検査を素通りする。**
    n=$(grep -oE 'コミット(数は)? [0-9,]+ 件|[0-9,]+ 個のコミット' "$f" | tail -1 | grep -oE '[0-9,]+' | tr -d ',' || true)
    sha=$(grep -oE 'git rev-list --count [0-9a-f]{7,40}' "$f" | tail -1 | awk '{print $NF}' || true)
    [ -n "$n" ] && [ -n "$sha" ] || continue
    if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      echo "  [NG] $(basename "$f"): 脚注の $sha がこのリポジトリに無い"
      fail=1; continue
    fi
    actual=$(git rev-list --count "$sha")
    checked=$((checked + 1))
    if [ "$actual" != "$n" ]; then
      echo "  [NG] $(basename "$f"): コミット $n 件と書いてあるが、$sha の実測は $actual 件"
      fail=1
    fi
  done
  echo "  [ok] コミット数の主張 $checked 件を実物の git で検算した"
fi

# ---- 字数の主張が、原稿の実測と一致しているか ------------------------
#
# なぜ要るか（2026-09-18）。**同じ商品の字数が、外から読める3面で3つとも違っていた。**
# README 45,938 / LISTING.md 46,838 / 紹介ページ 49,065、実測 50,919。
# 紹介ページだけは `data-metric` の印を持っていて `bin/sitecheck` が毎回突き合わせており、
# **印を持つ1面だけが正しく、印を持たない2面が腐っていた。**
#
# LISTING.md は「**そのまま貼ってください**」と渡す商品説明であり、README は公開リポジトリの顔である。
# どちらも道具ではなく**売り物**なので、検査は原稿の側（この道具）に置く。
#
# 印は HTML コメント `<!-- metric:manuscript-chars -->` で、**主張と同じ行に置く。**
# 行を分けない理由: 過去の訂正記録にも同じ字数の文字列が現れるので、
# **文面での grep では「いまの主張」と「訂正前の記録」を区別できない。**
# 印の付いた行だけを見る（`site/index.html` の `data-metric` と同じ考え方である）。
# 面の一覧は既定を持つが、**上書きできるようにしてある。**
# 合成の原稿で検出力だけを測る回帰テスト（bin/selftest U2 節）が、
# 実物の README を書き換えずにこの節を叩けるようにするためである。
# **検査に検査を当てられない道具は、検出力を測れない。**
FACES="${BOOKCHECK_FACES:-README.md venture/book/LISTING.md}"
COUNT_SH="$(dirname "$DIR")/count.sh"
if [ -x "$COUNT_SH" ] || [ -f "$COUNT_SH" ]; then
  chars=$(bash "$COUNT_SH" 2>/dev/null | awk '/^合計/ {print $NF}')
else
  chars=""
fi
if [ -z "$chars" ]; then
  # **測れなかったことを、一致の報告に混ぜない**（浅いクローンの扱いと同じ）
  echo "  [--] 字数を測れなかった（$COUNT_SH が読めない）。**字数の主張は検査していない**"
else
  marked=0
  # **この節の中で落ちた件数を別に数える。** `fail` は脚注の検査と共有されているので、
  # これを使って分岐すると、脚注が落ちた回に字数の報告まで黙る。
  # 逆に数えずに `[ok]` を出すと、**1 件落ちた回に「2 件一致した」と言う。**
  # 変異テストで実際にそう出た（2026-09-18）。**検査の出力も、検算される対象である。**
  cfail=0
  for f in $FACES; do
    [ -f "$f" ] || continue
    while IFS= read -r line; do
      marked=$((marked + 1))
      # 印のある行から、最初に現れる「N 字」を拾う
      claim=$(printf '%s' "$line" | grep -oE '[0-9][0-9,]* 字' | head -1 | grep -oE '[0-9,]+' | tr -d ',')
      if [ -z "$claim" ]; then
        echo "  [NG] $f: metric:manuscript-chars の印はあるが、同じ行に字数が無い"
        fail=1; cfail=$((cfail + 1)); continue
      fi
      if [ "$claim" != "$chars" ]; then
        echo "  [NG] $f: 字数 $claim と書いてあるが、実測は $chars"
        fail=1; cfail=$((cfail + 1))
      fi
    done < <(grep -F 'metric:manuscript-chars' "$f" || true)
  done
  if [ "$marked" -eq 0 ]; then
    # **印が1つも無いことを「一致」と言わない。** 検査していないだけである
    echo "  [NG] 売り物の面に metric:manuscript-chars の印が1つも無い。**字数は検査されていない**"
    fail=1
  elif [ "$cfail" -eq 0 ]; then
    echo "  [ok] 字数の主張 $marked 件が原稿の実測（$chars 字）と一致した"
  else
    echo "  [--] 字数の主張 $marked 件のうち $cfail 件が食い違っている（上の [NG]）"
  fi
fi

# ── SUMMARY の検索語（2026-09-20 追加）────────────────────────────────
# **なぜ要るか。** 09-20 の回が SUMMARY を書き換えて `Claude Code` を獲得し、
# **同じ操作で `エージェント` を失った**（98 位 / 144 件 → 249 件を全走査して不在）。
# 旧文の「AI エージェント」が新文で「自律エージェント」になり、独立した語が消えたためである。
# **獲得は測ったが、失ったものは測っていなかった。** 気づいたのは次の回の再測である。
#
# SUMMARY は「読者が検索する語」が入る唯一の欄なので（`bin/zennbuild` の注）、
# **実測で引けると分かっている語が、書き換えで黙って消えることを防ぐ。**
#
# **この検査はネットワークを叩かない。** 叩くと、回線が無い回に赤くなる——
# 良性の状態を緊急事態と読み違える形である（§3）。
# だから「実測済みの語の一覧」を固定値として持ち、SUMMARY にそれが在るかだけを見る。
# **一覧を増やすときは、必ず `search_rank.sh` で引けることを確かめてから足すこと。**
ZB="bin/zennbuild"
if [ -f "$ZB" ]; then
  summary=$(sed -n '/^SUMMARY = (/,/^)/p' "$ZB")
  if [ -z "$summary" ]; then
    echo "  [NG] $ZB から SUMMARY を読み出せなかった。**検索語は検査していない**"
    fail=1
  else
    sfail=0
    # 2026-09-20 12:47-12:50 UTC に search_rank.sh で順位が付くことを確かめた語だけを置く
    for w in "Claude Code" "AI エージェント"; do
      if ! printf '%s' "$summary" | grep -qF "$w"; then
        echo "  [NG] SUMMARY に実測済みの検索語『$w』が無い。**書き換えで落ちている**"
        fail=1; sfail=$((sfail + 1))
      fi
    done
    if [ "$sfail" -eq 0 ]; then
      echo "  [ok] SUMMARY は実測済みの検索語 2 件を保っている"
    fi
  fi
else
  echo "  [--] $ZB が無い。**検索語は検査していない**"
fi

if [ "$fail" -ne 0 ]; then
  echo ">> 原稿の数値がリポジトリと食い違っている。**まえがきは読者に検算を勧めている。**"
  exit 1
fi
# **検算していないのに「一致している」と言わない。**
# 浅い回でその一文を出すと、読んだ側は検算が通ったと受け取る。
# この回が直したのは、まさにその形の嘘である。
if [ "$shallow" != "false" ]; then
  echo "脚注の有無だけ確認した。**コミット数は検算していない。**"
else
  echo "原稿の数値主張は実物と一致している。"
fi
