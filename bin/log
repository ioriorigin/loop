#!/usr/bin/env bash
# 重要な結果・行動・思考を日次ログに追記する。追記のみ。上書きしない。
#   使い方: ./bin/log "見出し" "本文"
#           ./bin/log "見出し" < body.txt
source "$(dirname "$0")/_common.sh"

title="${1:?usage: log <title> [body]}"
if [ $# -ge 2 ]; then body="$2"; else body="$(cat)"; fi

f="$(logfile)"
{
  printf '\n## %s\n\n' "$title"
  printf -- '- 時刻: %s\n\n' "$(ts_both)"
  printf '%s\n' "$body"
} >> "$f"
echo "logged -> ${f#"$ROOT/"}"
