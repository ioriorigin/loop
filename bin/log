#!/usr/bin/env bash
# 重要な結果・行動・思考を日次ログに追記する。追記のみ。上書きしない。
#   使い方: ./bin/log "見出し" "本文"
#           ./bin/log "見出し" < body.txt
source "$(dirname "$0")/_common.sh"

title="${1:?usage: log <title> [body]}"
# 本文なし・パイプなしで呼ぶと cat が端末を待って無限にハングする。
# 定期起動セッションがこれを踏むと、その回はタイムアウトまで無言で溶ける。
if [ $# -ge 2 ]; then
  body="$2"
elif [ ! -t 0 ]; then
  body="$(cat)"
else
  echo "本文がない。第2引数か標準入力で渡せ。" >&2; exit 2
fi

f="$(logfile)"
{
  printf '\n## %s\n\n' "$title"
  printf -- '- 時刻: %s\n\n' "$(ts_both)"
  printf '%s\n' "$body"
} >> "$f"
echo "logged -> ${f#"$ROOT/"}"
