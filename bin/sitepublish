#!/usr/bin/env bash
# `site/index.html` を組み上げて `gh-pages` へ押す。**配信される複製を、手で触らせない。**
#
# 2026-09-15 に分かったこと（H036-792）。GitHub Pages は設定 API（`POST /repos/{o}/{r}/pages`）
# では 403 で拒否されるが、**`gh-pages` という名前のブランチを push すると自動で有効化される。**
# つまりこの出口は、オーナーを1人も必要としない。
#
# **だから腐る。** 配信物が別ブランチにある以上、`site/index.html` を直した回が
# 押し直しを忘れれば、外から読める面だけが古いまま残る。
# `bin/pagestamp` / `bin/sitecheck` が塞いだのと同じ形の腐りが、もう1段外側に開く。
# **毎回わざわざ叩く道具は、いずれ叩かれなくなる**（H005）。だから `checkpoint` の経路に載せる。
#
# 冪等である。組み上げた中身が既に gh-pages に載っていれば、何も押さない。
#
# 使い方:
#   ./bin/sitepublish          # 変わっていれば押す
#   ./bin/sitepublish --check  # 押さない。差分の有無だけを返す（0=一致 / 1=差分 / 2=異常）
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PAGES_BRANCH="gh-pages"
PAGES_URL="https://ioriorigin.github.io/loop/"
CHECK_ONLY=0
[ "${1:-}" = "--check" ] && CHECK_ONLY=1

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

"$ROOT/bin/sitebuild" "$TMP/out" >/dev/null
# **原稿の web 版も同じ経路で配信する**（2026-09-16 追加）。
# 別の道具・別の手順で押すと、押し直しを忘れる回が必ず来る。出口は1つにする。
"$ROOT/bin/bookbuild" "$TMP/out/book" >/dev/null

# ---- robots.txt と sitemap.xml -----------------------------------------
# **なぜ要るか（2026-09-17）。** H036-b08 を refuted で閉じた日に測った——
# 商品名の完全一致クエリは 0 件、Referring sites は自分の LP 1 本のみ、
# **そして robots.txt も sitemap.xml も 404 だった。**
# 仮説は「索引されている面が商品を指していない」だったが、実測は逆で、
# **そもそも索引される前提が置かれていなかった。**
#
# **一覧を手で書かない。** 組み上げた木そのものから作る。
# 手書きの一覧は、ページを1枚足した回が必ず更新を忘れる——
# H035-9ad がずっと測っている腐りと同じ型である。
#
# **lastmod は入れない。** 組んだ日付を入れると木が毎回変わり、
# 「変わっていなければ押さない」という sitepublish の冪等性が壊れる。
# sitemap の仕様上 lastmod は任意である。**冪等性のほうが大事。**
{
  echo '<?xml version="1.0" encoding="UTF-8"?>'
  echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
  while IFS= read -r f; do
    f="${f#./}"
    case "$f" in
      index.html)   loc="$PAGES_URL" ;;
      */index.html) loc="$PAGES_URL${f%index.html}" ;;
      *)            loc="$PAGES_URL$f" ;;
    esac
    echo "  <url><loc>$loc</loc></url>"
  done < <(cd "$TMP/out" && find . -type f -name '*.html' | LC_ALL=C sort)
  echo '</urlset>'
} > "$TMP/out/sitemap.xml"

printf 'User-agent: *\nAllow: /\nSitemap: %ssitemap.xml\n' "$PAGES_URL" > "$TMP/out/robots.txt"

# IndexNow の鍵ファイル。**このファイルが配信されていることが、送信の認証そのものである。**
# 鍵は固定する。作り直すと過去の送信が無効になり、木も毎回変わって冪等性が壊れる。
if [ -f "$ROOT/site/indexnow-key.txt" ]; then
  key="$(tr -d '[:space:]' < "$ROOT/site/indexnow-key.txt")"
  printf '%s' "$key" > "$TMP/out/$key.txt"
fi

# 配信物は複数ファイルになった。**1本の blob ではなく、木ぜんたいを比べる。**
# index.html だけを見ていると、`book/` を直した回が「最新」と報告される。
build_tree() {
  local dir="$1" idx="$2" f mode blob
  rm -f "$idx"
  while IFS= read -r f; do
    f="${f#./}"
    mode=100644
    [ -x "$dir/$f" ] && mode=100755
    blob="$(git -C "$ROOT" hash-object -w "$dir/$f")"
    GIT_INDEX_FILE="$idx" git -C "$ROOT" update-index --add --cacheinfo "$mode,$blob,$f"
  done < <(cd "$dir" && find . -type f | LC_ALL=C sort)
  GIT_INDEX_FILE="$idx" git -C "$ROOT" write-tree
}

NEW_TREE="$(build_tree "$TMP/out" "$TMP/index")"

# いま gh-pages に載っている木。**origin を取り直してから読む**——
# ローカルの追跡 ref はコンテナが clone した時点のままでありうる。
# 取れなければ「不明」として押す側に倒す（黙って一致と読まない）。
OLD_TREE=""
if git -C "$ROOT" fetch -q origin "$PAGES_BRANCH" 2>/dev/null; then
  OLD_TREE="$(git -C "$ROOT" rev-parse "FETCH_HEAD^{tree}" 2>/dev/null || true)"
fi

if [ -n "$OLD_TREE" ] && [ "$OLD_TREE" = "$NEW_TREE" ]; then
  echo "  ok — 配信物は最新（$PAGES_BRANCH は組み上げた中身と一致）"
  exit 0
fi

if [ "$CHECK_ONLY" = "1" ]; then
  if [ -z "$OLD_TREE" ]; then
    echo "  >> $PAGES_BRANCH の中身を読めなかった。一致とは言えない"
  else
    echo "  >> $PAGES_BRANCH が古い。組み直した配信物と違う"
  fi
  exit 1
fi

TREE="$NEW_TREE"

# 親を繋ぐ。**孤立コミットを積み直さない**——配信物にも履歴を残す（記憶の不可侵原則）。
PARENT=""
[ -n "$OLD_TREE" ] && PARENT="$(git -C "$ROOT" rev-parse FETCH_HEAD 2>/dev/null || true)"

MSG="gh-pages: $(TZ=Asia/Tokyo date '+%Y-%m-%d %H:%M JST') の site/ と原稿の web 版を配信"
if [ -n "$PARENT" ]; then
  COMMIT="$(printf '%s\n' "$MSG" | git -C "$ROOT" commit-tree "$TREE" -p "$PARENT")"
else
  COMMIT="$(printf '%s\n' "$MSG" | git -C "$ROOT" commit-tree "$TREE")"
fi

if git -C "$ROOT" push origin "$COMMIT:refs/heads/$PAGES_BRANCH" >/dev/null 2>&1; then
  echo "  ok — 配信物を押した: $PAGES_URL"
else
  echo "  >> $PAGES_BRANCH へ押せなかった。**外から読める面だけが古いまま残る。**"
  exit 1
fi
