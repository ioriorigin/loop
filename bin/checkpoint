#!/usr/bin/env bash
# セッションを終える手順を1コマンドにまとめる。
# 手順が複数あると必ずどれかを飛ばす。飛ばす余地を構造から消す。
#   ./bin/checkpoint "ログ見出し" "ログ本文" <+|-> "密度の根拠"
#
# 第3引数以降は 2026-09-02 追加。`bin/round close` を締めの経路に組み込むためのもの。
# 手で叩く手順にすると必ず飛ばす（それがこのスクリプトの存在理由そのものである）。
# 印は + が濃い回、- が薄い回。判定基準は .claude/rules/autonomous-loop.md「薄い回の定義」。
source "$(dirname "$0")/_common.sh"

BRANCH="$WORK_BRANCH"   # 定義は _common.sh。押す先の文字列を写し取らない
title="${1:?usage: checkpoint <log-title> <log-body> [+|-] [密度の根拠]}"
body="${2:-}"
mark="${3:-}"
mark_note="${4:-}"
if [ -z "$body" ]; then
  if [ ! -t 0 ]; then body="$(cat)"; else
    echo "本文がない。第2引数か標準入力で渡せ。" >&2; exit 2; fi
fi

echo "── 1/5 ログを記録"
"$ROOT/bin/log" "$title" "$body"

echo "── 2/5 この回の密度を台帳に残す"
# 所要時間と密度を残さない限り、規則の停止条件（薄い回が3回連続）は参照する量を持たない。
# 印を省いても止めはしない。**だが省いた回は「?」として残り、薄い回として数えられる。**
# 黙って通すと、いちばん自分に不利な条文だけが静かに空文化する。
if [ -n "$mark" ]; then
  "$ROOT/bin/round" close "$mark" "${mark_note:-（根拠の記載なし。規則により薄い回として扱う）}" || exit 1
else
  echo "  >> 密度の印が無い。第3引数に + か - を渡せ（第4引数に根拠）。"
  echo "  >> 今回は未クローズのまま進む。この回は密度を数えられない回として残る。"
fi

echo "── 3/5 STATE.md が実際に更新されたかを確認"
# mtime で見てはいけない。clone すると全ファイルの mtime が clone 時刻になり、
# STATE.md を一文字も書き換えていなくても「0分前に更新済み」で必ず素通りする。
# トリガー起動のセッションは毎回 clone/チェックアウトから始まるので、
# 強制を最も必要とする経路でだけ無効になっていた（2026-08-30 の診断で指摘）。
# HEAD との差分で見る。内容が変わっていなければ通さない。
if [ ! -f "$MEM/STATE.md" ]; then
  echo "  >> STATE.md が無い。作れ。"; exit 1
fi
if git -C "$ROOT" diff --quiet HEAD -- memory/STATE.md 2>/dev/null; then
  echo "  >> STATE.md が HEAD から1文字も変わっていない。"
  echo "  >> 現在地を書き換えてから checkpoint し直せ。ログは記録済み。"
  exit 1
fi
echo "  ok（HEAD から変更あり）"

echo "── 4/5 commit"
git -C "$ROOT" add -A
if git -C "$ROOT" diff --cached --quiet; then
  echo "  変更なし。commit をスキップ"
else
  git -C "$ROOT" -c user.name="loop" -c user.email="ioriorigin@gmail.com" \
    commit -q -m "$title

$(printf '%s' "$body" | head -12)

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>"
  echo "  ok"
fi

echo "── 5/5 push"
for i in 1 2 3 4; do
  if git -C "$ROOT" push -u origin "$BRANCH" 2>&1 | tail -1; then
    echo "  ok — 記憶を外部に固定した"
    exit 0
  fi
  w=$(( 2 ** i )); echo "  push 失敗。${w}秒後に再試行 ($i/4)"; sleep "$w"
done
echo "  >> push に4回失敗した。**今回の記憶は失われる。** 手動で原因を潰せ。"
exit 1
