#!/usr/bin/env bash
# 記録系スクリプトの回帰テスト。使い捨ての一時ディレクトリで全経路を通す。
#
# なぜこれがあるか:
#   「使う前に一度通す」と自分で書いた直後に、未検証のスクリプトを本番で叩いて2回壊した。
#   3度目の決意ではなく、決意を不要にする仕組みが要る。それがこれ。
#   bin/ を触ったら必ず走らせること。preflight からも自動で呼ばれる。
set -uo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

# 作業ブランチ名は _common.sh が唯一の定義元。ここで写し取ると、切り替えたときに
# テストだけが古い名前を見続ける。source しないのは _common.sh の `set -euo pipefail` が
# このテスト自身のシェルに効いてしまうため（I0 節の注記と同じ理由）。
WORK_BRANCH="$(sed -n 's/^WORK_BRANCH="\(.*\)"$/\1/p' "$SRC/bin/_common.sh")"

pass=0; fail=0
ok()   { printf '  [ok]   %s\n' "$1"; pass=$((pass+1)); }
ng()   { printf '  [NG]   %s\n' "$1"; fail=$((fail+1)); }
check(){ if [ "$1" -eq 0 ]; then ok "$2"; else ng "$2"; fi; }

# --- 足場を組む ---
mkdir -p "$T/bin" "$T/memory/notes" "$T/memory/log" "$T/memory/mentor"
cp "$SRC"/bin/{_common.sh,log,note,hypo,recall,checkpoint,round} "$T/bin/"
chmod +x "$T"/bin/*
printf '# 自己定義\nテスト用。\n' > "$T/memory/IDENTITY.md"
# inbox.md は「存在するが1件も無い」状態で置く。これが grep -c が exit 1 を返す実条件。
# ファイル自体が無いと recall は grep に到達せず、バグを踏まないままテストが通ってしまう。
printf '# 気づきの受け皿\n\n' > "$T/memory/notes/inbox.md"
printf '# 現在地\nテスト用。\n'   > "$T/memory/STATE.md"
# OPERATING.md も同型の切り落としを起こしうる。ここは起動・push 復旧・停止条件の手順が入る場所で、
# 末尾ほど「困ったときに読む」内容になる。前半だけ出す実装は、困っている自分にだけ届かない。
{ printf '# 運転手順\n'; for i in $(seq 1 60); do printf 'padding %s\n' "$i"; done
  printf '## メンター診断\nOPERATING_TAIL_MUST_SURVIVE\n'; } > "$T/memory/OPERATING.md"
# INFRA.md は「深い位置に置いた印が recall の出力に出るか」で切り落としを検出する
{ printf '# 稼働インフラ\n'; for i in $(seq 1 60); do printf 'padding %s\n' "$i"; done
  printf '### 既知の制約（重要）\nDEEP_MARKER_MUST_SURVIVE\n'; } > "$T/memory/INFRA.md"
# メンター診断も同型の切り落としが起きる。診断は最も重い指摘（盲点・次にやるべきこと）が後半に来るので、
# 前半だけ出す実装は「一番読ませたい部分だけが届かない」という最悪の壊れ方をする。
# 実際 bin/recall に sed -n '1,40p' が残っていて、前回診断の盲点が生まれ直した自分に一度も届いていなかった。
{ printf '# 診断 2026-01-01\n'; for i in $(seq 1 60); do printf 'padding %s\n' "$i"; done
  printf '## 盲点\nMENTOR_TAIL_MUST_SURVIVE\n'; } > "$T/memory/mentor/2026-01-01.md"

echo "自己テスト: $(TZ=Asia/Tokyo date '+%Y-%m-%d %H:%M:%S JST')"
echo "作業ディレクトリ: $T"
echo

echo "A. recall — 気づきメモが空でも行動ログ節まで到達するか"
# grep -c はヒット0件で exit 1 を返す。set -e 下で recall 全体が黙って死んでいた。
out=$("$T/bin/recall" 2>&1); rc=$?
check $rc "exit 0 で終了する"
grep -q '行動ログ' <<<"$out"; check $? "「行動ログ」節が出力される"
grep -q '呼び戻し完了' <<<"$out"; check $? "最後まで到達する"

echo "B. recall — INFRA.md の末尾が切り落とされないか"
grep -q 'DEEP_MARKER_MUST_SURVIVE' <<<"$out"; check $? "INFRA.md の深い位置の記述が生き残る"

echo "B1. recall — 運転手順が出力され、末尾まで切り落とされないか"
# 運転手順は 2026-08-31 まで git の外（トリガーのプロンプト）にしか無かった。
# 経路に載せた以上、載り続けることをテストで担保する。
grep -q '運転手順 (memory/OPERATING.md)' <<<"$out"; check $? "運転手順の節が出力される"
grep -q 'OPERATING_TAIL_MUST_SURVIVE' <<<"$out"; check $? "運転手順の末尾が生き残る"

echo "B1b. recall — 運転手順が欠けたら黙らずに警告するか"
# 無いのに黙って通ると、手順が消えたことに誰も気づかない。静かな失敗を作らない。
mv "$T/memory/OPERATING.md" "$T/memory/OPERATING.md.bak"
out_no=$("$T/bin/recall" 2>&1); check $? "  欠けていても exit 0 で最後まで走る"
grep -q '運転手順が無い' <<<"$out_no"; check $? "  欠けていることを明示的に警告する"
grep -q '呼び戻し完了' <<<"$out_no"; check $? "  警告しても後続の節は止まらない"
mv "$T/memory/OPERATING.md.bak" "$T/memory/OPERATING.md"

echo "B2. recall — メンター診断の末尾が切り落とされないか"
# 診断は後半ほど重い（盲点・次にやるべきこと）。前半だけ出す実装は最悪の壊れ方をする。
grep -q 'MENTOR_TAIL_MUST_SURVIVE' <<<"$out"; check $? "診断の末尾（盲点の節）が生き残る"

echo "C. recall — 引数が壊れていても死なないか"
out2=$("$T/bin/recall" xyz 2>&1); check $? "非数値引数 'xyz' でも exit 0"
grep -q '行動ログ' <<<"$out2"; check $? "  行動ログ節まで到達する"
"$T/bin/recall" all >/dev/null 2>&1; check $? "'all' が通る"
"$T/bin/recall" 999 >/dev/null 2>&1; check $? "日数がログ数を超えても通る"

echo "D. log / note — 本文なしでハングしないか"
# body=$(cat) が端末を待って無限に固まる経路。定期起動セッションが踏むと丸1回無言で溶ける。
# </dev/null を渡すと cat が即座に返るのでバグを再現できない。実 tty が要る。
# python の pty で本物の端末を割り当てて呼ぶ。
timeout 8 python3 -c '
import pty,sys,os
sys.exit(0 if os.WEXITSTATUS(pty.spawn([sys.argv[1], "見出しのみ"])) or True else 0)
' "$T/bin/log" >/dev/null 2>&1
rc=$?
[ "$rc" -ne 124 ]; check $? "tty から本文なしで呼んでもハングしない（timeout 124 を返さない）"
"$T/bin/log" "見出し" "本文" >/dev/null 2>&1; check $? "引数2つの log が通る"
printf '標準入力から\n' | "$T/bin/log" "見出し" >/dev/null 2>&1; check $? "パイプ経由の log が通る"
"$T/bin/note" "気づき" >/dev/null 2>&1; check $? "note が通る"

echo "E. hypo — 追記だけで状態遷移が畳めるか"
id=$("$T/bin/hypo" add "テスト仮説" 2>/dev/null); check $? "add が通る"
[[ "$id" =~ ^H001-[0-9a-f]{3}$ ]]; check $? "  採番が H001- で始まり乱数の接尾辞が付く"
"$T/bin/hypo" list 2>/dev/null | grep -q "$id"; check $? "  list に open として出る"
"$T/bin/hypo" close "$id" verified "根拠" >/dev/null 2>&1; check $? "close が通る"
! "$T/bin/hypo" list 2>/dev/null | grep -q "^$id "; check $? "  close 後は list から消える"
id2=$("$T/bin/hypo" add "次" 2>/dev/null)
[[ "$id2" =~ ^H002- ]]; check $? "  close 済みを飛ばさず H002 を採番する"
# 2026-08-30 の実障害の回帰テスト。並行する2セッションが同一の台帳を見て同時に採番すると、
# 連番だけでは同じ ID を別の仮説に振ってしまい、awk の畳み込みが別物を1つの仮説として混ぜる。
cp "$T/memory/hypotheses.md" "$T/ledger.snapshot"
a=$("$T/bin/hypo" add "並行A" 2>/dev/null)
cp "$T/ledger.snapshot" "$T/memory/hypotheses.md"   # 相手が書く前の台帳に巻き戻す = 同時採番の再現
b=$("$T/bin/hypo" add "並行B" 2>/dev/null)
[ "${a%%-*}" = "${b%%-*}" ]; check $? "  同時採番は連番部分が一致する（衝突条件の再現）"
[ "$a" != "$b" ]; check $? "  それでも ID 全体は衝突しない"
! "$T/bin/hypo" close H999 verified "x" >/dev/null 2>&1; check $? "存在しない ID の close は失敗する"

echo "E2. hypo — 古いイベントが後ろに積まれても決着が蘇らないか"
# 2026-08-31 の実障害の回帰テスト。追記専用ファイルは .gitattributes の merge=union で併合されるため、
# 並行セッションが書いた**古いイベントがファイルの後ろに来る**。畳み込みを出現順で行っていたため、
# 自分で verified にした H003 が open として復活していた。決定を黙って取り消す台帳は、間違った台帳より悪い。
cat >> "$T/memory/hypotheses.md" <<'LEDGER'

- id: H900-aaa
  - `2026-08-31 00:10:00 UTC / 2026-08-31 09:10:00 JST` **open** 先に立てた仮説

- id: H900-aaa
  - `2026-08-31 00:50:00 UTC / 2026-08-31 09:50:00 JST` **verified** 決着させた（新しい）

- id: H900-aaa
  - `2026-08-31 00:20:00 UTC / 2026-08-31 09:20:00 JST` **open** 並行セッションが書いた古いイベント（union で後ろに積まれた）
LEDGER
! "$T/bin/hypo" list 2>/dev/null | grep -q '^H900-aaa '; check $? "古い open が後から積まれても復活しない"

# 逆方向。本当に開き直した（annotate した）ものは open のままでなければならない。
# 「出さない」だけなら、全部隠す実装でもテストは通ってしまう。
cat >> "$T/memory/hypotheses.md" <<'LEDGER'

- id: H901-bbb
  - `2026-08-31 00:10:00 UTC / 2026-08-31 09:10:00 JST` **verified** いったん決着

- id: H901-bbb
  - `2026-08-31 01:00:00 UTC / 2026-08-31 10:00:00 JST` **open** 後から検証条件が変わって開き直した
LEDGER
"$T/bin/hypo" list 2>/dev/null | grep -q '^H901-bbb '; check $? "新しい open は正しく open のまま残る"

echo "F. 追記原則 — 過去の記述が消えていないか"
grep -q 'テスト仮説' "$T/memory/hypotheses.md"; check $? "close しても元の仮説文が台帳に残る"
grep -q '見出しのみ\|見出し' "$T/memory/log"/*/*/*.md; check $? "ログが追記されている"

echo "G. 日付境界 — ログのファイル名が JST で切られるか"
expect="$(TZ=Asia/Tokyo date '+%Y-%m-%d').md"
[ -f "$T/memory/log/$(TZ=Asia/Tokyo date '+%Y/%m')/$expect" ]; check $? "JST の日付でファイルが作られる（$expect）"

echo "H. checkpoint — STATE.md を更新せずに締められないか"
# mtime 判定だと clone 直後は必ず age=0 で素通りする。内容ベースでなければ意味がない。
G="$(mktemp -d)"
mkdir -p "$G/bin" "$G/memory/notes" "$G/memory/log"
cp "$SRC"/bin/{_common.sh,log,note,hypo,recall,checkpoint,round} "$G/bin/"; chmod +x "$G"/bin/*
printf '# 現在地\n初期状態。\n' > "$G/memory/STATE.md"
git -C "$G" init -q 2>/dev/null
git -C "$G" add -A >/dev/null 2>&1
git -C "$G" -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1
# STATE.md を触らずに checkpoint → STATE ゲートで止まるべき
before_n=$(git -C "$G" rev-list --count HEAD)
outc=$("$G/bin/checkpoint" "見出し" "本文" 2>&1); rc=$?
after_n=$(git -C "$G" rev-list --count HEAD)
# 終了コードだけ見てはいけない。mtime 判定のままでも push 失敗で exit≠0 になり、
# テストが「別の理由で」通ってしまう。コミットが増えていないことを構造で確かめる。
[ "$before_n" = "$after_n" ]; check $? "STATE.md 無変更ならコミットが作られない"
[ "$rc" -ne 0 ]; check $? "  かつ exit 0 で終わらない"
grep -q '1文字も変わっていない' <<<"$outc"; check $? "  STATE ゲートで止まったと分かるメッセージが出る"
# STATE ゲートで止まった回は、台帳にも触れていないこと。
# 触れていると close 行だけが残り、**やり直しの checkpoint が二重 close になる。**
# 締めをやり直せない締めの道具は、締めの道具ではない。2026-09-02 に実際に踏んだ。
printf '# 台帳\n\n- `t` epoch=1788000000 x\n' > "$G/memory/rounds.md"
"$G/bin/checkpoint" "見出し" "本文" + "根拠" >/dev/null 2>&1
! grep -q 'mark=' "$G/memory/rounds.md"
check $? "  STATE ゲートで止まった回は台帳に close 行を書かない（やり直せる）"
# STATE.md を書き換えれば、少なくとも STATE ゲートは通過する
printf '# 現在地\n書き換えた。\n' > "$G/memory/STATE.md"
outc2=$("$G/bin/checkpoint" "見出し" "本文" 2>&1)
grep -q '4/5 commit' <<<"$outc2"; check $? "STATE.md を更新すれば commit 段階まで進む"
# 密度の印を渡したら、締めの経路が round close を呼んで台帳に残すこと。
# 手で叩く手順にすると必ず飛ばす。飛ばす余地を構造から消すのが checkpoint の存在理由である。
printf '# 現在地\nさらに書き換えた。\n' > "$G/memory/STATE.md"
"$G/bin/checkpoint" "見出し" "本文" + "外向き1件" >/dev/null 2>&1
grep -q 'mark=+' "$G/memory/rounds.md" 2>/dev/null
check $? "  密度の印を渡すと checkpoint が台帳に close 行を残す"
rm -rf "$G"
echo "H2. checkpoint — 旧ブランチ（起動の入口）へ同じ地点を転送するか"
# トリガーのプロンプトが古いブランチ名を pull し続ける間、旧ブランチが起動の入口になる。
# **手で押す前提にすると必ず飛ばす**（H005: 毎回わざわざ叩く道具は、いずれ叩かれなくなる）。
# だから checkpoint の経路に載せた。載せた以上、載っていることをテストで固定する。
# venture/ASKS.md A-005 が片付いたら、この節ごと消してよい。
G2="$(mktemp -d)"; B2="$(mktemp -d)"
mkdir -p "$G2/bin" "$G2/memory/notes" "$G2/memory/log"
cp "$SRC"/bin/{_common.sh,log,note,hypo,recall,checkpoint,round} "$G2/bin/"; chmod +x "$G2"/bin/*
LEGACY="$(sed -n 's/^LEGACY_ENTRY_BRANCH="\(.*\)"$/\1/p' "$SRC/bin/_common.sh")"
[ -n "$LEGACY" ]; check $? "_common.sh が旧ブランチ名を定義している"
git init -q --bare "$B2/remote.git"
git -C "$G2" init -q -b "$WORK_BRANCH"
git -C "$G2" remote add origin "$B2/remote.git"
printf '# 現在地\n初期状態。\n' > "$G2/memory/STATE.md"
printf '# 台帳\n\n- `t` epoch=1788000000 x\n' > "$G2/memory/rounds.md"
git -C "$G2" add -A >/dev/null 2>&1
git -C "$G2" -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1
git -C "$G2" push -q origin "HEAD:refs/heads/$LEGACY" >/dev/null 2>&1
printf '# 現在地\n書き換えた。\n' > "$G2/memory/STATE.md"
outf=$("$G2/bin/checkpoint" "見出し" "本文" + "根拠" 2>&1)
head_sha=$(git -C "$G2" rev-parse HEAD)
[ "$(git -C "$G2" ls-remote origin "refs/heads/$WORK_BRANCH" | awk '{print $1}')" = "$head_sha" ]
check $? "  作業ブランチへ押している（記憶の本体）"
[ "$(git -C "$G2" ls-remote origin "refs/heads/$LEGACY" | awk '{print $1}')" = "$head_sha" ]
check $? "  旧ブランチも同じ地点へ進んでいる（古い名前で起動した回が締めを見られる）"
grep -q '旧ブランチ' <<<"$outf"; check $? "  転送したことを黙らずに言う"

# **--force を使っていないこと。** 旧ブランチに無関係な履歴が乗っている状況で
# 押し切ると、記憶の入口を上書きする。fast-forward でないなら押さないのが正しい。
#
# **ここは条件の作り方が肝である。** 作業ブランチ側も ff でない状態にすると、
# checkpoint は 5/5 の push で先に落ち、**転送の分岐に一度も到達しないまま**
# 「旧ブランチは進んでいない」が成立してしまう。それは別の理由で通ったテストであり、
# --force の有無を何も測っていない（この節を書いた初版が実際にそうなっていた）。
# だから **作業ブランチは ff のまま、旧ブランチだけを無関係な履歴へずらす。**
X="$(mktemp -d)"
git -C "$X" init -q -b tmp
printf 'x\n' > "$X/x.txt"; git -C "$X" add -A >/dev/null 2>&1
git -C "$X" -c user.name=t -c user.email=t@t commit -qm orphan >/dev/null 2>&1
git -C "$X" remote add origin "$B2/remote.git"
git -C "$X" push -q --force origin "HEAD:refs/heads/$LEGACY" >/dev/null 2>&1
legacy_before=$(git -C "$X" ls-remote origin "refs/heads/$LEGACY" | awk '{print $1}')
# **2回目の締めには2回目の回が要る。** 直前の checkpoint が既に close 行を書いており、
# 開いていない回を閉じようとすると checkpoint は push まで到達せずに落ちる。
# それに気づかずに書くと、rc も ref も「別の理由で」動かないまま通ってしまう。
"$G2/bin/round" open "2回目" >/dev/null 2>&1
printf '# 現在地\nさらに書き換えた。\n' > "$G2/memory/STATE.md"
outf2=$("$G2/bin/checkpoint" "見出し" "本文" + "根拠" 2>&1); rc2=$?
head2=$(git -C "$G2" rev-parse HEAD)
[ "$rc2" -eq 0 ]; check $? "  旧ブランチへ押せなくても締めは落ちない（保険であって本体ではない）"
[ "$(git -C "$G2" ls-remote origin "refs/heads/$WORK_BRANCH" | awk '{print $1}')" = "$head2" ]
check $? "    作業ブランチへの push は成功している（＝転送の分岐に到達している）"
legacy_after=$(git -C "$X" ls-remote origin "refs/heads/$LEGACY" | awk '{print $1}')
[ "$legacy_before" = "$legacy_after" ]
check $? "  ff でない履歴を旧ブランチへ流し込まない（--force を使っていない）"
grep -q '転送できなかった' <<<"$outf2"; check $? "  押せなかったことを黙らずに言う"
rm -rf "$X"
rm -rf "$G2" "$B2"

echo "J. round — 見ていない発火を検出できるか"
# 停止条件のカウンタが手動だと、途中で死んだ回は数えられず規定が素通りする。
# 台帳に空白が空いたことを機械が言えなければ、この仕組みは無いのと同じ。
# だから「空白を見逃さない」だけでなく「空白でないものを空白と言わない」も確かめる。
L="$T/memory/rounds.md"
: > "$L"
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '発火の記録なし' <<<"$out"; check $? "空の台帳で『記録なし』と言う"

# 12時間刻みで3件 — 空白は無いはず
: > "$L"
for k in 0 43200 86400; do
  printf -- '\n- `t%s` epoch=%s x\n' "$k" $((1788000000+k)) >> "$L"
done
out=$("$T/bin/round" gaps 12 2>&1)
! grep -q '\[空白\]' <<<"$out"; check $? "正常な間隔を空白と誤検出しない"
grep -q '見落とした発火は無い' <<<"$out"; check $? "  正常時はその旨を明示する"

# 2件目と3件目の間を36時間あける — 空白1件を検出するはず
: > "$L"
for k in 0 43200 172800; do
  printf -- '\n- `t%s` epoch=%s x\n' "$k" $((1788000000+k)) >> "$L"
done
out=$("$T/bin/round" gaps 12 2>&1)
[ "$(grep -c '\[空白\]' <<<"$out")" = "1" ]; check $? "36時間の空白をちょうど1件検出する"
grep -q '見ていない発火がある可能性' <<<"$out"; check $? "  見落としがある旨を明示する"

# open は起動直後に呼ばれる。解析可能な行を必ず1行足すこと
before=$(grep -c 'epoch=' "$L")
"$T/bin/round" open "テスト" >/dev/null 2>&1; check $? "open が通る"
[ "$(grep -c 'epoch=' "$L")" = "$((before+1))" ]; check $? "  open は解析可能な行を1行だけ足す"
# 橋頭堡 push は起動手順の1行目に埋まっている。**ここで止まる実装は、その回を丸ごと殺す。**
# git の無い場所でも、押せない場所でも、落ちずに理由を言って進むこと。
outo=$("$T/bin/round" open "git外" 2>&1); check $? "  git 管理外でも open は落ちない"
grep -q '橋頭堡 push は省略' <<<"$outo"; check $? "  押さなかった理由を黙らずに言う"

echo "J1a. round close — 並行する回があっても自分の回を閉じるか"
# 2026-09-02 の実障害の回帰テスト。台帳は全セッションが同じファイルに追記する。
# close が「台帳の最後の open」に付く実装だったので、**00:45 の回の close が 01:13 の回に付いた。**
# 結果、自分の回は未クローズのまま、他人の回に close 行が2本並んだ。
# 台帳は停止条件が読む唯一の量である。**取り違えた台帳は、無い台帳より悪い。**
P="$(mktemp -d)"; Q="$(mktemp -d)"
for d in "$P" "$Q"; do
  mkdir -p "$d/bin" "$d/memory"; cp "$SRC"/bin/{_common.sh,round} "$d/bin/"; chmod +x "$d"/bin/*
done
# 2つのコンテナが同じ台帳を共有する状況を作る（実体は1つ、印はそれぞれ別）
"$P/bin/round" open "自分の回" >/dev/null 2>&1
cp "$P/memory/rounds.md" "$Q/memory/rounds.md"
sleep 1
"$Q/bin/round" open "並行する他人の回" >/dev/null 2>&1     # 台帳の最後の open は他人のものになる
cp "$Q/memory/rounds.md" "$P/memory/rounds.md"
mine=$(awk '{print $1}' "$P/.round-current")
"$P/bin/round" close + "自分の根拠" >/dev/null 2>&1
grep -q "for=$mine" "$P/memory/rounds.md"; check $? "close は自分の open を指す（for= が一致する）"
# **`| grep -q` で受けない。** grep -q は一致した瞬間に降りてパイプを閉じるので、
# その後ろでまだ書いている round が SIGPIPE で死に、pipefail が 141 を拾う。
# 実際 orphans 節を gaps の末尾に足した瞬間、この1件だけが落ちた。**計器ではなく読み方の問題である。**
outg=$("$P/bin/round" gaps 12 2>&1)
grep -q '自分の根拠' <<<"$outg"
check $? "  gaps が自分の回に密度を出す"
[ "$("$P/bin/round" gaps 12 2>&1 | grep -c '未クローズ)')" = "1" ]
check $? "  他人の回だけが未クローズとして残る（自分の回に付け替わらない）"
! "$P/bin/round" close + "もう一度" >/dev/null 2>&1
check $? "  同じ回を二度閉じない"
# 印を失った回は、帰属を確かめられない。**確かめていない帰属を、確かめた帰属と同じ形で書かない。**
# 2026-09-02、この経路が他人の回に close を2度付けた。1度目の訂正の直後にもう1度である。
rm -f "$P/.round-current"
outu=$("$P/bin/round" close + "印を失った回" 2>&1)
grep -q 'for=? ' "$P/memory/rounds.md"; check $? "  印が無い回の close は for=? と書く（帰属を偽らない）"
grep -q '確かめられない' <<<"$outu"; check $? "  そのとき黙らずに警告する"
rm -rf "$P" "$Q"

echo "J1b. round open — 橋頭堡 push が台帳行だけを外に固定するか"
# 第3回診断「次にやるべきこと1」。台帳行の永続化が、その回の最後の push に依存していた。
# 8時間41分 commit ゼロで走った回があり、回収されていれば丸ごと消えていた。
R="$(mktemp -d)"; B="$(mktemp -d)"
mkdir -p "$R/bin" "$R/memory"
cp "$SRC"/bin/{_common.sh,round} "$R/bin/"; chmod +x "$R"/bin/*
git init -q --bare "$B/remote.git"
git -C "$R" init -q -b "$WORK_BRANCH"
git -C "$R" remote add origin "$B/remote.git"
printf '# 台帳\n' > "$R/memory/rounds.md"
printf 'x\n' > "$R/other.txt"      # 台帳以外の未コミット変更。巻き込んではいけない
git -C "$R" add memory/rounds.md >/dev/null 2>&1
git -C "$R" -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1
"$R/bin/round" open "橋頭堡テスト" >/dev/null 2>&1
[ "$(git -C "$R" rev-list --count HEAD)" = "2" ]; check $? "open が台帳行を commit する"
git -C "$R" ls-remote origin 2>/dev/null | grep -q "$WORK_BRANCH"
check $? "  作業ブランチへ push されている（次の自分が読める場所に残る）"
git -C "$R" show --stat --name-only HEAD | grep -q 'other.txt'
[ $? -ne 0 ]; check $? "  台帳以外の変更を巻き込まない"
# ハーネスが別ブランチを割り当てて起動する回が実在する。**直近3回すべてがそれだった。**
# 旧実装はそこで「commit はしたが push しない」と言って止まっており、
# **橋頭堡 push は、それが最も要る回で一度も動いていなかった**（2026-09-03 / H024-26b）。
# 台帳行の永続化を「その回の最後の push」から切り離すために作った仕組みが、
# 呼ばれる状況では常に退化した入力（＝作業ブランチにいない）へ落ちていた。
# 正しい振る舞いは「ブランチ名ではなく、作業ブランチの **ref** へ HEAD を押す」である。
git -C "$R" checkout -q -b claude/harness-assigned
printf 'y\n' >> "$R/memory/rounds.md"
outb=$("$R/bin/round" open "別ブランチ" 2>&1)
grep -q '橋頭堡 push ok' <<<"$outb"
check $? "  割り当てブランチにいても台帳行を作業ブランチへ固定する"
git -C "$R" ls-remote origin refs/heads/"$WORK_BRANCH" 2>/dev/null \
  | grep -q "$(git -C "$R" rev-parse HEAD)"
check $? "    押した先は作業ブランチの先端である（次の自分が読む場所）"
[ "$(git -C "$R" ls-remote origin 2>/dev/null | grep -c harness-assigned)" = "0" ]
check $? "  見えない場所にブランチを作らない"

# **良性側を広げすぎない。** 作業ブランチを含まない履歴の上にいる回で押してしまうと、
# 無関係な履歴を記憶のブランチへ流し込む。判定はサーバの fast-forward 検査に委ねる。
git -C "$R" checkout -q --orphan claude/unrelated
git -C "$R" -c user.name=t -c user.email=t@t commit -qm orphan >/dev/null 2>&1
tip_before=$(git -C "$R" ls-remote origin refs/heads/"$WORK_BRANCH" 2>/dev/null | awk '{print $1}')
printf 'z\n' >> "$R/memory/rounds.md"
outn=$("$R/bin/round" open "無関係な履歴" 2>&1); check $? "  ff でない回でも open は落ちない"
grep -q '橋頭堡 push 失敗' <<<"$outn"; check $? "    押せなかったことを黙らずに言う"
tip_after=$(git -C "$R" ls-remote origin refs/heads/"$WORK_BRANCH" 2>/dev/null | awk '{print $1}')
[ "$tip_before" = "$tip_after" ]; check $? "    無関係な履歴を作業ブランチへ流し込まない"
rm -rf "$R" "$B"

# close — 回の内側を測る。open だけの台帳は「回と回の間」しか見ていなかった（第3回診断の盲点1）
: > "$L"
"$T/bin/round" open "テスト回" >/dev/null 2>&1
"$T/bin/round" close + "外向き1件" >/dev/null 2>&1; check $? "close が通る"
# close 行が発火として数えられてはいけない。数えると間隔が半分に見え、空白検出が壊れる
[ "$(grep -cE '^- `.*epoch=' "$L")" = "1" ]; check $? "  close 行は発火として数えられない"
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '直近の回（所要時間と密度）' <<<"$out"; check $? "  gaps が回の内側（所要時間と密度）を出す"
# 根拠なしの close は通してはいけない。自己申告は必ず甘くなる
"$T/bin/round" close + >/dev/null 2>&1; [ $? -ne 0 ]; check $? "  根拠なしの close は拒否される"
"$T/bin/round" close x "y" >/dev/null 2>&1; [ $? -ne 0 ]; check $? "  + か - 以外の印は拒否される"
# 薄い回3連続 = 規則の停止条件。参照する量をここで初めて機械が持つ
: > "$L"
for k in 1 2 3; do
  "$T/bin/round" open "薄い回$k" >/dev/null 2>&1
  "$T/bin/round" close - "全部ゼロ" >/dev/null 2>&1
done
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が 3 回連続' <<<"$out"; check $? "  薄い回が3回続いたら停止条件を突きつける"
# 濃い回が1つ挟まれば連続は切れる。切れないと警告が鳴りっぱなしになり、誰も読まなくなる
"$T/bin/round" open "濃い回" >/dev/null 2>&1
"$T/bin/round" close + "README 修正" >/dev/null 2>&1
out=$("$T/bin/round" gaps 12 2>&1)
! grep -q '薄い回が' <<<"$out"; check $? "  濃い回が入れば連続は切れる"

echo "I0. preflight — 測る対象と、経路が実際に押す対象が一致しているか"
# 2026-09-03 / H024-26b の1件目の回帰テスト。
# preflight は `git push --dry-run origin "$BRANCH"` で**ローカルの同名 ref** を測っていた。
# ハーネスが別ブランチを割り当てて起動する回では、その ref は放置されて遅れており、
# **この回が絶対に押さない ref について「非 fast-forward。pull せよ」と報告していた。**
# 同じ瞬間、実際に押す形（HEAD → 作業ブランチ）は clean な fast-forward だった。
# **計器が測る対象は、経路が踏む対象と同じでなければ、何も測っていないのと同じである。**
grep -q 'push --dry-run origin "HEAD:refs/heads/\$BRANCH"' "$SRC/bin/preflight"
check $? "preflight は HEAD → 作業ブランチの形で測る（ローカルの古い同名 ref ではない）"
grep -q 'push -q origin "HEAD:refs/heads/\$WORK_BRANCH"' "$SRC/bin/round"
check $? "  round open の橋頭堡 push が同じ形で押す"
grep -q 'push origin "HEAD:refs/heads/\$BRANCH"' "$SRC/bin/checkpoint"
check $? "  checkpoint の締めの push も同じ形で押す（手順で覆っていた3件目）"

echo "I. preflight — push 失敗の理由を取り違えないか"
# 2026-08-30 の実障害の回帰テスト。遅れているだけの non-fast-forward を
# 「push できない」と報告し、停止規則を誤発動させかけた。誤警報は1回分のコストになる。
source "$SRC/bin/_common.sh"
# _common.sh は `set -euo pipefail` を持っている。source はそれを**このテスト自身のシェルに効かせる。**
# つまりこの行より後ろでは、assert が1件でも落ちた瞬間に errexit でスイートごと即死し、
# [NG] も「結果: 成功N/失敗M」も出ないまま終わる。**失敗を報告できないテストになっていた。**
# 2026-09-02、J 節を足して実際に踏んだ（変異テストで落ちるはずが、無言で終了した）。
# 落ちることを確かめない限り、この壊れ方は永久に見えない。README「テストは、バグを検出できることまで
# 確かめる」の実例がテスト自身に出た形である。errexit をここで戻す。
set +e
k=$(push_err_kind " ! [rejected]  branch -> branch (non-fast-forward)
error: failed to push some refs to 'https://github.com/ioriorigin/loop'
hint: Updates were rejected because the tip of your current branch is behind")
[ "$k" = "stale" ]; check $? "non-fast-forward を stale と判定する"
k=$(push_err_kind "remote: Permission to ioriorigin/loop.git denied to someone.
fatal: unable to access 'https://github.com/ioriorigin/loop/': The requested URL returned error: 403")
[ "$k" = "auth" ]; check $? "権限拒否を auth と判定する"
k=$(push_err_kind "fatal: Authentication failed for 'https://github.com/ioriorigin/loop/'")
[ "$k" = "auth" ]; check $? "認証失敗を auth と判定する"
k=$(push_err_kind "fatal: unable to access: Could not resolve host: github.com")
[ "$k" = "unknown" ]; check $? "未知のエラーを auth や stale に誤分類しない"

# 2026-09-02 追加。コンテナが main の浅いクローンで作り直された回で実際に出た文面。
# 分類が2つしか無かったため unknown に落ち、preflight が「原因不明。今すぐ原因を潰せ」と
# 報告した。規則の停止条件（push 不能ならその回は原因究明だけ）が良性の状態で誤発動する。
k=$(push_err_kind "error: src refspec claude/autonomous-ai-agent-design-jv7jv6 does not match any
error: failed to push some refs to 'https://github.com/ioriorigin/loop'")
[ "$k" = "noref" ]; check $? "ローカル ref の不在を noref と判定する（良性・認証は未測定）"

# 逆方向。**良性側の分類を広げすぎない**ことを確かめる検出器。
# noref は「ブランチを作れば直る」と読まれるので、本物の異常を巻き込むと素通りする。
k=$(push_err_kind "fatal: 'origin' does not appear to be a git repository
fatal: Could not read from remote repository.")
[ "$k" != "noref" ]; check $? "remote 不在を noref（良性）に巻き込まない"


echo "K. 外向き文書 — README の現行構成が実態から腐っていないか"
# なぜこれがあるか:
#   README は git の中にあるのに、2回続けて現実を偽った。08-31 12:51 に書き直した45分後に
#   構成が変わり、以後3回の発火を経ても誰も直さなかった。メンター第2回・第3回で同じ指摘を受けている。
#   **同じ指摘を2度受けた時点で、意志では守れないことが確定している。だから構造に落とす。**
#   2026-09-02 に public になったので、この腐りは外から読める誤情報になった。
readme="$SRC/README.md"; infra="$SRC/memory/INFRA.md"
[ -f "$readme" ]; check $? "README.md が存在する"
# 「現在の稼働構成」節だけを切り出す。歴史として残した旧方式の記述は対象外にする。
cur=$(awk '/^## 現在の稼働構成/{f=1;next} /^###? /{if(f)exit} f' "$readme")
[ -n "$cur" ]; check $? "  「現在の稼働構成」節を抽出できる"
# 旧方式（束ね）の語が現行の構成表に残っていたら落とす。歴史節に出るのは正しいので節を限定している。
! grep -qE '常駐ワーカー|永続セッション' <<<"$cur"
check $? "  現行構成の節に旧方式（常駐ワーカー/永続セッション）が書かれていない"
# 構成表の cron が、実際に空白検出が使っている間隔と一致するか。
# 最初はこれを「INFRA.md に同じ文字列があるか」で書いた。**通ったが、バグを捕まえられなかった。**
# INFRA.md は追記専用なので、過去の `44 * * * *` も永久に残っている。どんな古い cron を
# README に書いても「INFRA のどこかにある」で通ってしまう。
# 追記専用のファイルは、grep の対象としては「何でも肯定する計器」である。
# だから文書ではなく、道具が持っている数値（bin/round の DEFAULT_INTERVAL_H）に突き合わせる。
cron=$(grep -oE '44 [0-9*/]+ [0-9*/]+ [0-9*/]+ [0-9*/]+' <<<"$cur" | head -1)
[ -n "$cron" ]; check $? "  現行構成の節に cron が書かれている"
hf=$(awk '{print $2}' <<<"$cron")            # 時フィールド。*/12 なら 12 時間おき、* なら毎時
case "$hf" in */*) rh="${hf#*/}";; '*') rh=1;; *) rh=24;; esac
ih=$(grep -oE '^DEFAULT_INTERVAL_H=[0-9]+' "$SRC/bin/round" | cut -d= -f2)
[ -n "$ih" ]; check $? "  bin/round が期待間隔の定数を持っている"
[ "$rh" = "$ih" ]; check $? "  README の cron($cron)が round の期待間隔(${ih}h)と一致する"

# 2026-09-02 追加。memory/ に置いた記憶ファイルが README の「構造」に全部載っているか。
#
# なぜ要るか: memory/BOOTSTRAP.md が README のどこにも載っていなかった。
# **このファイルは「リポジトリを読んでも起動の仕方が分からない」を直すために作られたもの**であり、
# それ自身が外向きの地図から漏れていた。目的1（他人が同じ構造を組める）に直接効く欠落である。
# 上の cron 検査と同じ発想: 手で直すと必ずまた腐るので、実物どうしを突き合わせる。
# 参照する側（README）ではなく**実在するファイルの側を基準にする。** 文書を基準にすると、
# 消えたファイルの記述が残っていても通ってしまう（追記専用文書と同じ「何でも肯定する計器」）。
missing=""
for mf in "$SRC"/memory/*.md; do
  b=$(basename "$mf")
  grep -q "$b" "$readme" || missing="$missing $b"
done
[ -z "$missing" ]; check $? "  memory/ の全記憶ファイルが README に載っている（漏れ:${missing:-なし}）"

# 2026-09-05 追加（第4回診断「出来ていない点3」）。**上の検査は型が直っていなかった。**
#
# すぐ上のコメントに「参照する側ではなく**実在するファイルの側を基準にする**」と自分で書きながら、
# 実装は走査対象を `memory/` に固定していた。だから 2026-09-03 に `venture/`（プロジェクト一式）が
# 生えても、検査は何も言わない。**README に venture / Kindle / 135 が0件のまま selftest は緑だった。**
#
# これは「バグ1件を直して型を直していない」の再演である。09-03 のログに本人がこう書いている——
# 「バグ1件を直して型を直さない、はこの repo の再発パターン第1位である」。**書いた翌日にやった。**
#
# だから基準にする集合そのものを実物から取る。**git が追跡しているトップレベルのディレクトリ全部。**
# 新しいディレクトリが生えたら、README を直すまでここが落ちる。
# （`site/` のような外向きの静的物も対象に含める。README がリポジトリの地図である以上、
#   地図に無い区画があってはならない。除外したくなったら、除外の理由をここに書いてから除外すること）
missing=""
# `core.quotepath=false` が要る。既定では非 ASCII を含むパスが `"venture/book/…"` と
# ダブルクォートで括られて返り、cut が `"venture` を切り出して別区画に見える。
# **原稿のファイル名が日本語であるせいで、計器が区画を二重に数えていた。**
for d in $(cd "$SRC" && git -c core.quotepath=false ls-files 2>/dev/null | grep '/' | cut -d/ -f1 | sort -u); do
  grep -q "$d" "$readme" || missing="$missing $d"
done
[ -z "$missing" ]; check $? "  git が追跡する全トップレベル区画が README に載っている（漏れ:${missing:-なし}）"

echo
echo "L. 停止条件が実際に発動できるか（2026-09-03 追加）"
# **これまで一度も発動できなかった。** gaps は密度の連続を台帳の末尾から遡って数えるが、
# gaps を呼ぶのは bin/recall だけで、recall は round open の**直後**に走る。
# つまり末尾は必ず「いま走っている回」（mark=?）であり、遡りはそこで必ず切れていた。
# 薄い回を何回続けても停止条件は沈黙する。参照する量を作った（第3回診断の宿題）だけでは足りず、
# **読む側が末尾で必ず躓く形になっていた。** 計器を足して、計器が読まれない形にしていた。
ledger() { printf '# 発火台帳\n' > "$L"; }
row() { # row <連番> <印|open> [根拠]
  local e=$((1788000000 + $1 * 43200))
  printf '\n- `R%s UTC / R%s JST` epoch=%s 定期発火\n' "$1" "$1" "$e" >> "$L"
  [ "$2" = open ] && return 0
  printf '  close `C%s UTC / C%s JST` elapsed=0.2h mark=%s for=%s %s\n' \
    "$1" "$1" "$2" "$e" "${3:-根拠}" >> "$L"
}

# 検出器。ここが落ちなければ、この節は何も守っていない
ledger; row 1 -; row 2 -; row 3 -; row 4 open
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が 3 回連続' <<<"$out"
check $? "薄い回3連続は、いま走っている回が末尾にあっても停止条件を出す"

# 煙感知器。「常に出す」実装でも上が通ってしまうので、逆向きを固定する
ledger; row 1 +; row 2 +; row 3 +; row 4 open
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が' <<<"$out"; [ $? -ne 0 ]
check $? "  濃い回が続いている間は停止条件を出さない"

# 上の2件は、末尾を起点から外す処理を戻す変異では**どちらも落ちない。**
# 「?」を薄い回と数える規則が入ったので、末尾を数に入れても連続は 3 に届いてしまうためである。
# つまり上の2件は「元の欠陥の再発」は捕まえるが、**末尾の扱いそのものは固定していない。**
# 末尾を数に入れた実装は、こんどは**1回早く**停止条件を出す（偽陽性）。そちらで固定する。
ledger; row 1 +; row 2 -; row 3 -; row 4 open
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が' <<<"$out"; [ $? -ne 0 ]
check $? "  いま走っている回を薄い回に数え、1回早く停止条件を出すことがない"

# 締めを飛ばした回は「濃かった証拠を1つも残さずに終わった回」である。薄い回と数える（厳格化）
ledger; row 1 -; row 2 -; row 3 open; row 4 open
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が 3 回連続' <<<"$out"
check $? "  締めを飛ばした回は薄い回として連続に数える"
grep -q '締めを飛ばした回が 1 件' <<<"$out"
check $? "  締めを飛ばした回を、いま走っている回と混ぜずに数える"

# close 機構より前の回は原理的に閉じられない。毎回警告し続ければ、計器は読まれなくなる
# 印を持たない古い回を薄い回として遡ると、**過去の1件だけで連続3件に届いてしまう。**
# だから薄い回を1件だけ挟んだ形で固定する（濃い回を挟むと境界を外しても連続が切れて落ちない）。
ledger; row 1 open; row 2 open; row 3 -; row 4 open
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が' <<<"$out"; [ $? -ne 0 ]
check $? "  close 機構より前の回を薄い回の連続に数えない"
grep -q 'close 機構より前の回' <<<"$out"
check $? "  閉じられない過去は、警告ではなく事実として区別して出す"

# times は 2026-09-02 から recall に呼ばれていたが、実装が無く exit 2 していた。
# recall 側の `2>/dev/null || echo "(所要時間をまだ読めない)"` が、**壊れた節を良性に見せていた。**
ledger; row 1 +; row 2 +; row 3 open
out=$("$T/bin/round" times 2>&1)
check $? "round times が実装されている（recall が1日以上、無い副命令を呼んでいた）"
grep -q '最長' <<<"$out"; check $? "  全期間の外れ値を出す（gaps の直近5件では消える）"

# 型のほうを塞ぐ。実物どうしを突き合わせ、recall が呼ぶ副命令が全部実装されているかを見る。
# 手で直すだけなら、次に副命令を増やしたときまた同じ穴が開く。
badsub=""
for s in $(grep -oE '"\$ROOT/bin/round" [a-z]+' "$SRC/bin/recall" | awk '{print $2}' | sort -u); do
  grep -qE "^  $s\)" "$SRC/bin/round" || badsub="$badsub $s"
done
[ -z "$badsub" ]
check $? "  recall が呼ぶ round の副命令が全部実装されている（未実装:${badsub:-なし}）"

echo
echo "M. 台帳を書かずに走った回を、git 側から拾えるか（2026-09-03 追加）"
# gaps は台帳しか読まない。**1行も書かずに走った回は、原理的に見えない。**
# 2026-09-03、06:28 と 09:57 に commit を残した回が2つあったのに台帳に open 行が無く、
# それでも gaps は「見落とした発火は無い」と答えた（間隔 8.6h < 期待 12h で空白にならない）。
# **自己申告の計器は、申告しなかった回を永久に見落とす。** だから別の帳簿と突き合わせる。
# commit は、その回が走った動かぬ物証である。
G="$T/orph"
mkdir -p "$G/bin" "$G/memory"
cp "$SRC"/bin/{_common.sh,round} "$G/bin/"; chmod +x "$G"/bin/*
git -C "$G" init -q >/dev/null 2>&1
git -C "$G" config user.email t@example.invalid
git -C "$G" config user.name loop-test
OL="$G/memory/rounds.md"
now=$(date -u +%s); base=$((now - 172800))          # 2日前。--since 7日 の窓の内側に置く
gcommit() { # gcommit <epoch> <メッセージ>
  printf '%s\n' "$1" >> "$G/f.txt"
  ( cd "$G" \
    && export GIT_COMMITTER_DATE="@$1 +0000" GIT_AUTHOR_DATE="@$1 +0000" \
    && git add -A && git commit -q -m "$2" ) >/dev/null 2>&1
}
oled() { printf '# 発火台帳\n' > "$OL"; }
orow() { # orow <epoch> <elapsed時間|open>
  printf '\n- `X UTC / X JST` epoch=%s 定期発火\n' "$1" >> "$OL"
  [ "$2" = open ] && return 0
  printf '  close `Y UTC / Y JST` elapsed=%sh mark=+ for=%s 根拠\n' "$2" "$1" >> "$OL"
}

# 検出器。締めた回の窓（close + 余裕1時間）より後に打たれた commit は、台帳を書かなかった回のものである
oled; orow "$base" 0.2
gcommit $((base + 100))   "回の中で打った commit"
gcommit $((base + 20000)) "台帳を書かずに走った回の commit"
out=$("$G/bin/round" orphans 2>&1)
grep -q '台帳に1行も書かずに走った回がある' <<<"$out"
check $? "締めた回の窓の外に commit があれば、台帳を書かなかった回として検出する"
grep -q '台帳を書かずに走った回の commit' <<<"$out"
check $? "  どの commit が窓の外なのかを名指しする"

# 煙感知器。「常に鳴る」実装でも上は通ってしまうので、逆向きを固定する
grep -q '回の中で打った commit' <<<"$out"; [ $? -ne 0 ]
check $? "  窓の内側の commit を巻き込まない"

# **初版が実際に踏んだ欠陥の再発防止。**
# 未クローズの回の窓を無限に伸ばす実装だと、大昔の締め忘れが1件あるだけで以後すべてを覆う。
# 初版はそれで 06:28 / 09:57 の回を取り逃した（検出器は通るのに、本物は見つからない）。
# 未クローズの回の窓は**次の open まで**で切る。いま走っている回（最後の open）だけが無限でよい。
rm -rf "$G/.git" "$G/f.txt"; git -C "$G" init -q >/dev/null 2>&1
git -C "$G" config user.email t@example.invalid; git -C "$G" config user.name loop-test
oled; orow "$base" open; orow $((base + 40000)) 0.2
gcommit $((base + 80000)) "締め忘れの後ろに隠れた commit"
out=$("$G/bin/round" orphans 2>&1)
grep -q '締め忘れの後ろに隠れた commit' <<<"$out"
check $? "  過去の締め忘れが1件あっても、その後ろの回を覆い隠さない"

# 台帳より前の commit は、窓が存在しない時代のものである。毎回鳴らす計器は読まれなくなる
rm -rf "$G/.git" "$G/f.txt"; git -C "$G" init -q >/dev/null 2>&1
git -C "$G" config user.email t@example.invalid; git -C "$G" config user.name loop-test
oled; orow "$base" 0.2
gcommit $((base - 20000)) "台帳が始まる前の commit"
out=$("$G/bin/round" orphans 2>&1)
grep -q '台帳が始まる前の commit' <<<"$out"; [ $? -ne 0 ]
check $? "  台帳より前の commit を、台帳を書かなかった回として鳴らさない"
grep -q '台帳より前の commit 1 件' <<<"$out"
check $? "    ただし件数は事実として出す（黙って捨てない）"

# gaps から自動で呼ばれること。**呼ばれない計器は無いのと同じ**（L 節と同じ型の失敗を繰り返さない）
out=$("$G/bin/round" gaps 12 2>&1)
grep -qE '台帳の外で打たれた commit は無い|台帳に1行も書かずに走った回' <<<"$out"
check $? "  gaps が orphans を自動で呼ぶ（recall 経由で次の自分の目に必ず入る）"

# 日本語を byte 単位で切ると末尾が化ける。recall が毎回出す文面である
out=$(printf '日本語テスト' | awk '
  function utrim(s, n,   t, nxt) {
    if (length(s) <= n) return s
    t = substr(s, 1, n); nxt = substr(s, n+1, 1)
    if (nxt ~ /^[\200-\277]$/) { sub(/[\200-\277]+$/, "", t); sub(/[\300-\367]$/, "", t) }
    return t
  }
  { print utrim($0, 4) }')
[ "$out" = "日" ]
check $? "  切り詰めが文字の途中で切らない（gaps / orphans が使う utrim）"

echo
echo "N. オーナーへの未回答依頼の滞留計器（2026-09-05 追加）"
# 第4回診断「出来ていない点6」で足した recall の節。**実装中に2件の欠陥を踏んだので固定する。**
#
# 1件目: case のパターンでは '## [未]' が引用符で守られていたのに、切り出しの
#   ${line#*[未] } が**裸だった。** 裸の [未] は glob の文字クラスとして「[」「未」「]」の
#   どれか1文字にマッチする別物になる。よって一致だけして切り出しが素通りし、
#   見出しが丸ごと残っていた。**同じ文字列が、引用の有無で別の意味を持つ。**
# 2件目: 見出しの切り詰めに cut -c を使い、日本語を文字の途中で割った（上の utrim と同じ型）。
# recall は memory/ 一式と他の bin/ を触るので、この節専用の器を建てる。
# （上の orph 用 $G は bin/round しか持っていない。使い回すと「ファイルが無いので出力が空」を
#   「検査が通らない」と読み違える。**器の中身を確かめずに借りると、測っていないものを測ったことにする。**）
N="$T/asks"
mkdir -p "$N/bin" "$N/memory/notes" "$N/memory/log" "$N/memory/mentor" "$N/venture" "$N/.claude/rules"
cp "$SRC"/bin/{_common.sh,recall,round,hypo,log,note} "$N/bin/"; chmod +x "$N"/bin/*
: > "$N/memory/STATE.md"; : > "$N/memory/hypotheses.md"; : > "$N/memory/rounds.md"
cat > "$N/venture/ASKS.md" <<'EOA'
# オーナーへの依頼

## [未] A-901 — 見出しが正しく切り出されるか

- **起票:** 2020-01-01

## [済] A-902 — 済んだ依頼は数えない

- **起票:** 2020-01-01
EOA
out=$("$N/bin/recall" 1 2>/dev/null | sed -n '/未回答の依頼/,/未決着の仮説/p')
grep -q 'A-901 — 見出しが正しく切り出されるか' <<<"$out"
check $? "  未回答依頼の見出しから [未] の印を取り除いて出す"
grep -q 'A-902' <<<"$out"; [ $? -ne 0 ]
check $? "  [済] の依頼は滞留に数えない"
grep -qE '3日以上待っている依頼がある' <<<"$out"
check $? "  古い依頼があれば催促の判断を促す"
: > "$N/venture/ASKS.md"
out=$("$N/bin/recall" 1 2>/dev/null | sed -n '/未回答の依頼/,/未決着の仮説/p')
grep -q '未回答の依頼は無い' <<<"$out"
check $? "  依頼がゼロなら、その旨を出す（黙って空欄にしない）"

echo
echo "O. 台帳の行順が時刻順でない回でも、計器が嘘をつかないか（2026-09-05 追加）"
# **台帳は追記専用で、.gitattributes の merge=union で合流する。**
# ハーネスが割り当てたブランチで開いた回を後から作業ブランチへ merge すると、
# **新しい open 行が古い open 行より前に入る。** 2026-09-05 に実際にそうなった。
# そのとき gaps は同時に2つの嘘をついた。
#   (1) 09-04 12:44 → 09-05 12:44 を連続と読み、存在しない「24時間の空白」を報告した
#   (2) 末尾の行（00:45・締め済み）を「いま走っている回」と誤認し、
#       実際に走っている 12:44 の回を「締めを飛ばした回」＝**薄い回**として数えた
# **存在しない見落としと、存在しない薄い回を、同時に作っていた。**
# 割り当てブランチで起動する回はいま多数派なので、これは例外経路ではない。
#
# 一般化: **並び順を仮定する計器は、並び順を保証する媒体の上でしか正しくない。**
# 台帳は「追記のみ」を保証するが、「時刻順」は保証していない。

# 行順を入れ替えた台帳を作る。row は末尾へ足すので、後から古い回を足せば逆順になる。
outoforder() { # 直近2件が入れ替わっている台帳。4 が走っている回、3 は締め済み
  ledger; row 1 +; row 2 +; row 4 open; row 3 +
}

outoforder
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '空白' <<<"$out"; [ $? -ne 0 ]
check $? "行順が入れ替わっていても、存在しない空白を報告しない"

grep -q '締めを飛ばした回' <<<"$out"; [ $? -ne 0 ]
check $? "  走っている回を『締めを飛ばした回』と読み違えない"

grep -q '薄い回が' <<<"$out"; [ $? -ne 0 ]
check $? "  走っている回を薄い回に数えて停止条件を早く出さない"

# 表示も時刻順に直っていること。**読む側が並べ替えるのは、読む側の仕事ではない。**
last2=$("$T/bin/round" gaps 12 2>&1 | sed -n '/直近の回/,/^$/p' | grep -E '^    R' | tail -2 | awk '{print $1}')
[ "$(echo "$last2" | head -1)" = "R3" ] && [ "$(echo "$last2" | tail -1)" = "R4" ]
check $? "  『直近の回』の一覧が時刻順に並ぶ"

# 検出器が本当に効いているか（煙感知器）。順序を直しても本物の空白は消えないこと。
ledger; row 1 +; row 8 open
out=$("$T/bin/round" gaps 12 2>&1)
grep -q '空白' <<<"$out"
check $? "  本物の空白（期待間隔を大きく超える）は、並べ替えても消えない"

# .round-current による同定。**位置ではなく印で自分の回を外す。**
# 走っている回が時刻順でも末尾でないことがある（並行する回が後から開く）。
ledger; row 1 +; row 2 -; row 3 -; row 4 open
out=$(ROUND_CURRENT_EPOCH=$((1788000000 + 4 * 43200)) "$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が 2 回連続' <<<"$out"; [ $? -ne 0 ]
check $? "  .round-current の印がある回でも、薄い回の連続は正しく 2 で止まる"
grep -q '薄い回が' <<<"$out"; [ $? -ne 0 ]
check $? "  印で外した結果、まだ 3 に届いていない連続で停止条件を出さない"

ledger; row 1 -; row 2 -; row 3 -; row 4 open
out=$(ROUND_CURRENT_EPOCH=$((1788000000 + 4 * 43200)) "$T/bin/round" gaps 12 2>&1)
grep -q '薄い回が 3 回連続' <<<"$out"
check $? "  印で自分の回を外しても、薄い回3連続はきちんと発動する"

# orphans にも同じ欠陥がある。窓の走査は「締めていない回の窓は次の open まで」＝
# **O[i+1] が後の時刻であること**を前提にしている。行順が入れ替わると窓が裏返り、
# **いま走っている回の commit を『台帳を書かずに走った回の物証』として告発する。**
# 2026-09-05 に実際にそうなり、この回自身の橋頭堡 commit が2件、毎回名指しされていた。
rm -rf "$G/.git" "$G/f.txt"; git -C "$G" init -q >/dev/null 2>&1
git -C "$G" config user.email t@example.invalid; git -C "$G" config user.name loop-test
oled; orow $((base + 40000)) open; orow "$base" 0.2      # 行順が時刻順と逆
gcommit $((base + 40100)) "走っている回の中で打った commit"
out=$("$G/bin/round" orphans 2>&1)
grep -q '走っている回の中で打った commit' <<<"$out"; [ $? -ne 0 ]
check $? "  orphans も行順ではなく時刻順で窓を作る（自分の回の commit を告発しない）"

echo
echo "── 結果: 成功 $pass / 失敗 $fail"
if [ "$fail" -gt 0 ]; then
  echo ">> 壊れている。直すまで本番で使うな。"
  exit 1
fi
echo "全経路が通った。"
