#!/usr/bin/env bash
# 起動直後の健全性チェック。単一障害点を、手遅れになる前に潰す。
#   ./bin/preflight
source "$(dirname "$0")/_common.sh"

BRANCH="$WORK_BRANCH"   # 定義は _common.sh。押す先の文字列を写し取らない
fail=0
ok()   { printf '  [ok]   %s\n' "$1"; }
warn() { printf '  [注意] %s\n' "$1"; }
bad()  { printf '  [NG]   %s\n' "$1"; fail=1; }

echo "起動前チェック: $(ts_both)"
echo

# **項目3の測定を先に済ませる（2026-09-03）。項目1の判定がこれに依存するため。**
# 出力の順序は変えない。測る順序と、読ませる順序は別のものである。
#
# 押す形を `HEAD:refs/heads/$BRANCH` に変えた理由（H024-26b の1件目）。
# 旧実装は `git push --dry-run origin "$BRANCH"` で**ローカルの同名 ref**を押していた。
# ハーネスが別のブランチを割り当てて起動する回では、その ref は 23 コミット遅れたまま放置され、
# **この回が絶対に押さない ref について「非 fast-forward。pull せよ」と報告していた。**
# 実際にこの回が押す形（HEAD → 作業ブランチ）は、同じ瞬間に clean な fast-forward だった。
# 計器が測る対象と、経路が実際に踏む対象が食い違っていた。
# **押す形で測る。** bin/round open と bin/checkpoint が押す形と、ここを一致させること。
push_rc=0
push_err=$(git -C "$ROOT" push --dry-run origin "HEAD:refs/heads/$BRANCH" 2>&1) || push_rc=$?

echo "1. ブランチ"
cur=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)
if [ "$cur" = "$BRANCH" ]; then
  ok "$cur"
elif [ "$push_rc" -eq 0 ]; then
  # ハーネスが別ブランチを割り当てて起動する回。**直近ではこれが常態であって例外ではない。**
  # 規則の停止条件は「preflight が **push 不能**を報告したら原因究明だけに充てる」であって、
  # ブランチ名を条件にしていない。押せているのに NG を出すのは誤警報であり、
  # 誤警報を毎回出す計器は、やがて読まれなくなる（memory/OPERATING.md §3 と同じ型）。
  warn "$cur にいる（ハーネスの割り当て）。記録は HEAD → $BRANCH で押せる。作業を続けてよい"
else
  bad "$cur にいる。$BRANCH に切り替えよ（HEAD → $BRANCH の push も通っていない。3 を見よ）"
fi

echo "2. origin との同期"
if git -C "$ROOT" fetch -q origin "$BRANCH" 2>/dev/null; then
  behind=$(git -C "$ROOT" rev-list --count "HEAD..origin/$BRANCH" 2>/dev/null || echo 0)
  [ "$behind" = "0" ] && ok "最新" || bad "origin より ${behind} コミット遅れている。pull せよ"
else
  bad "fetch 失敗。ネットワークか認証を疑え"
fi

echo "3. push 権限（副作用なしで確認。**この回が実際に押す形で測る**）"
# ここが最大の単一障害点。作業を終えてから発覚すると、その回の記憶が丸ごと消える。
# ただし失敗理由を区別すること。理由は push_err_kind() のコメントに書いた。
# 測定は上で済ませてある（項目1がこの結果に依存するため）。
if [ "$push_rc" -eq 0 ]; then
  ok "push 可能（HEAD → $BRANCH）"
else
  case "$(push_err_kind "$push_err")" in
    stale)
      bad "非 fast-forward で弾かれた。**認証は生きている。** pull / merge してから押せ（2 を見よ）" ;;
    noref)
      # コンテナが main の浅いクローンで作り直された回に出る。良性だが、
      # **認証が生きている証拠にはならない**（リモートに触れる前に落ちている）。
      # 2026-09-03: 押す形を HEAD: に変えたので、この分類はもうほぼ出ない（HEAD は必ず解決する）。
      # **出なくなったからといって分類を消さない。** 別の経路が同じ形で落ちたとき、
      # 受け皿が無ければ unknown＝最悪側へ倒れる。それが 08-30 と 09-02 に2度起きた形である。
      bad "ローカルに $BRANCH が無いだけ（良性）。認証は**まだ測れていない。** git checkout -B $BRANCH origin/$BRANCH してから preflight をやり直せ" ;;
    auth)
      bad "push できない（認証・権限）。**今すぐ原因を潰せ。** これを放置すると今回の記憶は失われる" ;;
    *)
      first=$(printf '%s' "$push_err" | grep -iE 'fatal|error' | head -1 || true)
      bad "push できない（原因不明）。**今すぐ原因を潰せ。** ${first}" ;;
  esac
fi

echo "4. 記録スクリプト"
for s in log note hypo recall; do
  [ -x "$ROOT/bin/$s" ] && bash -n "$ROOT/bin/$s" 2>/dev/null && ok "bin/$s" || bad "bin/$s が壊れている"
done

echo "5. 記録系の回帰テスト"
SELFTEST_N=""
if [ -x "$ROOT/bin/selftest" ]; then
  # **件数を捨てない。** 項目9 が公開ページの「回帰テスト N 件」を検算するのに使う。
  # ここで捨てると、同じ 68 秒を 1 回の起動で 2 度払うことになる。
  if st_out=$("$ROOT/bin/selftest" 2>&1); then
    SELFTEST_N=$(printf '%s\n' "$st_out" | grep -oE '成功 [0-9]+' | tail -1 | grep -oE '[0-9]+' || true)
    ok "selftest 全通過${SELFTEST_N:+（$SELFTEST_N 件）}"
  else
    bad "selftest が失敗している。./bin/selftest を直接実行して原因を見よ"
  fi
else
  bad "bin/selftest が無い"
fi

echo "6. 制約の存在"
if [ -s "$ROOT/.claude/rules/autonomous-loop.md" ]; then ok "自律ループの制約あり"
else bad ".claude/rules/autonomous-loop.md が無い。停止条件のないループは暴走する"; fi

echo "7. 記憶ファイル"
for f in IDENTITY.md STATE.md INFRA.md; do
  [ -s "$MEM/$f" ] && ok "memory/$f" || bad "memory/$f が無い or 空"
done

# **8 は `main` を見る。作業木ではない。**（memory/OPERATING.md §12 / 第5回診断 次にやるべきこと1）
#
# 次の自分がハーネスから渡されるのは `main` の複製である。
# 09-07 12:44 の回は PR を 13:08 にマージし 13:11 に締めたので、**close と STATE が `main` に載らず、**
# 次の回はそれを「締めを飛ばした回」と読んで、メンターへの申し送りに事実誤認を3件混ぜた。
#
# **なぜ `selftest` ではなく `preflight` に置いたか（診断は selftest と書いていた）。**
# `selftest` は origin に触れる検査を1件も持たない。ネットワーク依存の検査を回帰テストへ入れると、
# **オフラインの回で必ず赤くなり、やがて読まれなくなる**——`preflight` が押せているのに
# 毎回 NG を出していたのと同じ型である。`preflight` はもともと origin に触れる道具で、
# 起動時にネットワークがある前提で走る。**判定の対象が同じでも、置く場所で寿命が変わる。**
# 判定そのものは `round unclosed` に分離してあるので、`selftest` は**合成の台帳で検出力だけを測る。**
echo "8. main に届いた記憶（次の自分が実際に読む台帳）"
# **読む前に `origin/main` を取り直す**（2026-09-14 修正。この項目が実際に誤った告発を出した）。
# 項目2で `fetch` しているのは**作業ブランチだけ**である。`origin/main` はコンテナが
# clone した時点のまま更新されず、この日は**2マージぶん古かった。**
# 結果、**21 時間前に締められた回（09-10 12:45）を「締めが載っていない」と告発した。**
# 次の自分がハーネスから渡されるのは**その時点の `main`** であって、
# **このコンテナが最後に取ってきた `main` の複製ではない。**
# **計器は「経路が実際に踏む対象」を測らなければ、何も測っていない**（OPERATING §3 の同じ型。
# 押す ref を取り違えていた件と、測っている対象が1つずれている点まで同じである）。
main_fresh=1
git -C "$ROOT" fetch -q origin main 2>/dev/null || main_fresh=0
if git -C "$ROOT" rev-parse --verify -q origin/main >/dev/null 2>&1; then
  # **「まだ閉じる番が来ていない回」は、台帳の末尾ではなく自分の回の epoch で決める**（2026-09-12 修正）。
  # `main` は作業ブランチより1回ぶん遅れているので、その末尾は「既に終わった回」である。
  # 末尾を (c) と決め打ちすると、**締めを飛ばした最新の回が、次の回の open 行が main に届くまで隠れる。**
  # 09-10 12:45 の回は丸1日隠れ、ここは2回続けて `[ok]` を出した。
  #
  # 自分の回の epoch は `.round-current`（`round open` がコンテナに置く印。git 管理外）から取る。
  # **無ければ渡さない。** 渡されなければ round 側は (c) を1件も除外しない＝余分に告発する側へ倒れる。
  # `round open` を通っていない回は、そもそも台帳に自分の行が無いので、除外すべき回も無い。
  my_epoch=$(awk 'NR==1{print $1}' "$ROOT/.round-current" 2>/dev/null || true)
  case "$my_epoch" in (*[!0-9]*|"") my_epoch="" ;; esac
  u_out=$(git -C "$ROOT" show origin/main:memory/rounds.md 2>/dev/null | "$ROOT/bin/round" unclosed - "$my_epoch" 2>&1) && u_rc=0 || u_rc=$?
  if [ "$u_rc" -eq 0 ]; then
    ok "origin/main の台帳に閉じ残しは無い"
  elif [ "$main_fresh" -eq 0 ]; then
    # **取り直せなかった複製での指摘は、告発として出さない。**
    # 古い複製は、既に閉じた回を「締めが載っていない」と言う（この修正のきっかけがそれである）。
    # オフラインは良性でありうる。**良性を緊急事態と読み違えると1回分を潰す**（OPERATING §3）。
    printf '%s\n' "$u_out" | sed 's/^/  /'
    warn "origin/main を取り直せていない。**上は古い複製での判定であり、既に閉じた回を挙げうる。** 先に git fetch origin main"
  else
    printf '%s\n' "$u_out" | sed 's/^/  /'
    bad "origin/main の台帳に締めが載っていない回がある。**その回の記憶は次の自分に届かない。** 内容を今回の PR に乗せよ（OPERATING §12）"
  fi
else
  # **良性を緊急事態と読み違えると1回分を潰す。** origin/main がローカルに無いのは
  # 浅いクローンや fetch 前の状態で普通に起きる。押せるかどうかとは無関係なので fail にしない。
  warn "origin/main がローカルに無いので測れない（git fetch origin main で測れるようになる）"
fi

echo
# **9 は「外から読める面」を見る。** 記憶ではなく、他人が読む側である。
# 2026-09-12 に実測: `site/index.html` は 09-05 時点の数字を **7日間** 公開していた。
# 発火19（実際39）・回帰テスト116（実際172）・**原稿42%（実際83%）。**
# 進捗を実際より遅く見せる嘘を、こちらから出していた。
#
# `memory/INFRA.md` は初版から「数字を変えたら、このページも見に行くこと」と書いている。
# **書いた本人が7日間見に行かなかった。** 注意書きは、見に行かせない。
# 見に行かせるのは、**起動のたびに必ず走る経路に置くこと**である（H005）。
# 判定は bin/pagestamp（しきい値と理由はそちらのコメント）。ここは実物を渡すだけ。
# **2026-09-14 追記: 鮮度と正しさは別の量である。**
# この項目は 09-12 から `pagestamp`（刻印の古さ）だけを見ており、
# 09-14 の起動時に `[ok] …の数字は 2026-09-12 時点（2 日前）` を出した。
# **その裏で、載っていた 6 件の数値のうち 5 件が既に誤っていた。**
# 刻印は「いつ測ったか」の代理変数であって、「いま正しいか」ではない。
# **`数字` と書いておきながら、測っていたのは日付だけだった。**
# だから判定を2本立てる——鮮度は bin/pagestamp、数値そのものは bin/sitecheck。
echo "9. 外から読めるページ（刻印の鮮度と、載っている数値そのもの）"
for page in "$ROOT/site/index.html"; do
  [ -f "$page" ] || continue
  p_out=$("$ROOT/bin/pagestamp" "$page" 2>&1) && p_rc=0 || p_rc=$?
  case "$p_rc" in
    0) ok "$p_out" ;;
    2) warn "$p_out" ;;
    *) bad "$p_out" ;;
  esac
  # selftest の件数は項目5で既に測っている。**1 回の起動で 2 度走らせない**（68 秒かかる）。
  s_out=$("$ROOT/bin/sitecheck" "$page" "${SELFTEST_N:-}" 2>&1) && s_rc=0 || s_rc=$?
  if [ "$s_rc" -eq 0 ]; then ok "$s_out"; else bad "$s_out"; fi
done

echo "10. 原稿（売り物）の数値が、リポジトリの実物と一致しているか"
# **まえがきは「本文がリポジトリと食い違っていたら、リポジトリのほうが正しい」と書き、**
# **読者に検算を勧めている。** 2026-09-13、その検算が4章ぶん合っていなかった。
# 原因は浅いクローンで、`git rev-list --count` が接ぎ木の境界で黙って止まっていた。
# 判定は bin/bookcheck。**浅い回は「測れない」と言って赤くしない**（良性を緊急事態と読まない）。
if [ -d "$ROOT/venture/book/manuscript" ]; then
  b_out=$("$ROOT/bin/bookcheck" "$ROOT/venture/book/manuscript" 2>&1) && b_rc=0 || b_rc=$?
  if [ "$b_rc" -eq 0 ]; then ok "$b_out"; else bad "$b_out"; fi
fi

echo "11. その頁が、実際に配信されているか（置いてあることと読めることは別である）"
# **2026-09-14 の診断の盲点そのものを計器にする。**
# それまで「公開した」と書いてきた5本の出口は、全部「置いてあるが読まれない」形をしていた。
# `site/index.html` は**リポジトリに在るだけで配信されていなかった**（`has_pages: false`）。
# 2026-09-15、gh-pages 経由で Pages が有効化できると分かった（H036-792）。
# **有効化した瞬間から、腐る先が2つになる**——リポジトリの原本と、配信されている複製。
# だから両方見る。(a) gh-pages が組み上げた中身と一致しているか、(b) その URL が実際に 200 を返すか。
# **(b) を省かない。** ブランチが正しくても、ビルドが落ちていれば外からは読めない。
# 判定は warn 止まりにする——ネットワークの一時的な失敗を、押せない事態と同じ赤で出さない
# （良性の状態を緊急事態と読み違えると1回分を潰す。項目8と同じ判断）。
if [ -x "$ROOT/bin/sitepublish" ]; then
  if sp_out=$("$ROOT/bin/sitepublish" --check 2>&1); then
    ok "$(printf '%s' "$sp_out" | sed 's/^ *ok — *//')"
  else
    warn "$(printf '%s' "$sp_out" | sed 's/^ *>> *//')（締めの push で自動的に押し直される）"
  fi
  live_code=$(curl -sS -o /dev/null -w '%{http_code}' -L --max-time 20 \
              https://ioriorigin.github.io/loop/ 2>/dev/null || echo "000")
  if [ "$live_code" = "200" ]; then
    ok "https://ioriorigin.github.io/loop/ は HTTP 200 を返している"
  else
    warn "https://ioriorigin.github.io/loop/ が HTTP $live_code。**外からは読めない状態である**"
  fi
fi

echo "12. Zenn の本（books/）が、いまの原稿と一致しているか"
# **なぜ起動時に見るのか。** `books/` は原稿の複製であり、**外から読める商品そのものである。**
# 原稿を直した回が複製を直し忘れれば、Zenn 側には古い本が並び続ける。
# しかも**腐ったことは Zenn 側からは分からない**——同期は成功し、中身だけが古い。
# 項目9（公開ページの数値）と同じ型の穴が、商品の本体にも開く。
#
# **ここは赤で出す。** 項目11 の配信確認と違って、これはネットワークに依存しない。
# 一時的な失敗ではありえず、**食い違っていれば必ず loop 側の直し忘れである。**
if [ -x "$ROOT/bin/zenncheck" ]; then
  if z_out=$("$ROOT/bin/zenncheck" 2>&1); then
    ok "$z_out"
  else
    # **2026-09-20 訂正。** ここは 09-17 の導入時から `ng` と書かれていた。
    # **そんな関数は無い**（定義してあるのは `ok` / `warn` / `bad` の3つである）。
    # 結果、この枝は `ng: command not found` を出すだけで、
    # **`[NG]` の行も出さず、`fail=1` も立てなかった。**
    # つまり **books/ が原稿と食い違っている回に、preflight は緑で「作業を始めてよい」と言う。**
    #
    # **3日間この枝は一度も実行されていない。** 実際に踏んだのは 2026-09-20 12:5x の回が
    # SUMMARY を書き換えて `bin/zennbuild` を走らせる前に preflight を叩いたときである。
    # **落ちたときの出力を一度も見ずに置いた検査は、落ちたときに嘘をつく**
    # （09-18 に同じ型を `bin/bookcheck` で踏み、メモにそう書いてある。**同じ週に2度目である**）。
    bad "$(printf '%s' "$z_out" | grep -m1 'NG' | sed 's/^ *\[NG\] *//')"
    echo ">> books/ が原稿と食い違っている。**./bin/zennbuild で組み直すこと**"
  fi
fi

echo "13. 発火間隔の較正（道具が持つ期待値と、実際に発火した時刻）"
# **【2026-09-19 追加】2026-09-17 18:44 UTC に cron が 12h → 6h へ変わり、loop は 30 時間気づかなかった。**
# その間ずっと `gaps` は「期待間隔 12 時間」と出し、6 時間おきの発火を
# 「不定期の起動（間隔の対象外）」へ落とし、STATE と PR には
# 「A-019（頻度の変更）は未回答」と書き続けた——**既に適用済みだった。**
#
# 既存の検査（selftest の「README の cron が round の期待間隔と一致する」）は
# **README の数字と DEFAULT_INTERVAL_H を突き合わせていた。どちらも loop が自分で書いた数字である。**
# **同じ主張の2つの複製を照合する検査は、常に合格する。** 実際 30 時間ずっと合格していた。
#
# **注意で出す。赤にしない。** cron を変えるのはオーナーで、loop は追随するしかない。
# 食い違い自体は緊急事態ではなく、「定数を直せ」という作業指示である。
if iv_out=$("$ROOT/bin/round" interval 2>&1); then
  while IFS= read -r line; do ok "${line#  }"; done <<< "$iv_out"
else
  while IFS= read -r line; do warn "${line#  }"; done <<< "$iv_out"
  echo ">> bin/round の DEFAULT_INTERVAL_H と INTERVAL_SINCE、README の cron を実測に合わせること"
fi

echo
if [ $fail -eq 0 ]; then
  echo "すべて正常。作業を始めてよい。"
else
  echo ">> 異常あり。作業を始める前に潰すこと。特に push は最優先。"
fi
exit $fail
