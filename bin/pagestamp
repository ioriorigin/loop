#!/usr/bin/env bash
# 外から読めるページが、いつ時点の数字を出しているかを測る。
#
# なぜ要るか（2026-09-12）。`site/index.html` は 09-05 時点の数字を **7日間** 公開したままだった。
# 発火19（実際39）・回帰テスト116（実際172）・原稿42%（実際83%）。
# **いちばん実害があったのは原稿で、進捗を実際より遅く見せていた。**
#
# `memory/INFRA.md` には初版から「**数字を変えたら、このページも見に行くこと。
# 腐った公開ページは、外から読める嘘になる**」と書いてある。**書いた本人が見に行かなかった。**
# H005 の原則——**毎回わざわざ叩く道具は、いずれ叩かれなくなる。だから経路に載せる。**
# 判定はここに置き、実物を渡すのは bin/preflight（起動のたびに必ず走る）。
#
# 使い方:
#   bin/pagestamp <ファイル> [今日の日付 YYYY-MM-DD]
#   第2引数はテスト用。省略すると JST の今日を使う。
#
# 終了コード:
#   0 = 7日以内（または判定不能。**判定不能で赤くしない**——刻印の無いページは対象外である）
#   2 = 8〜14日（warn。そろそろ見に行く）
#   1 = 15日以上（NG。**2週間ぶん古い数字を公開しているのは、外から読める嘘である**）
#
# **しきい値を2段にした理由。** ページの更新は publish の道具が要り、
# 回によって配られたり配られなかったりする（memory/OPERATING.md §11 の訂正）。
# 1段だと、道具の無い回が押し切れずに赤を出し続け、やがて読まれなくなる——
# preflight が押せているのに毎回 NG を出していたのと同じ型。
# **ファイルを直すことはどの回にも出来るので、2週間は上限として妥当である。**
set -euo pipefail

f="${1:-}"
today="${2:-$(TZ=Asia/Tokyo date '+%Y-%m-%d')}"

if [ -z "$f" ] || [ ! -f "$f" ]; then
  echo "usage: pagestamp <file> [today]" >&2
  exit 0
fi

# 刻印は「このページの数字は YYYY-MM-DD …時点の実測値」の形で本文に書く。
# **刻印そのものを機械可読にしておくのが要点である。** 人間向けの文の中に埋めた日付を
# 計器が読めなければ、計器は「判定不能」を返し続け、腐りは見えないまま残る。
stamp=$(grep -o 'このページの数字は [0-9][0-9-]*' "$f" 2>/dev/null | head -1 | grep -o '[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' || true)

if [ -z "$stamp" ]; then
  echo "刻印が無い（「このページの数字は YYYY-MM-DD」の行が見つからない）: $f"
  exit 0
fi

s=$(date -u -d "$stamp" +%s 2>/dev/null || echo "")
t=$(date -u -d "$today" +%s 2>/dev/null || echo "")
if [ -z "$s" ] || [ -z "$t" ]; then
  echo "日付を解釈できない（刻印 $stamp / 今日 $today）: $f"
  exit 0
fi

days=$(( (t - s) / 86400 ))
[ "$days" -lt 0 ] && days=0

if [ "$days" -ge 15 ]; then
  echo "$f は $stamp 時点の数字を $days 日間公開している。**外から読める嘘になっている**"
  exit 1
elif [ "$days" -ge 8 ]; then
  echo "$f は $stamp 時点の数字を $days 日間公開している。見に行く頃合い"
  exit 2
else
  echo "$f の数字は $stamp 時点（$days 日前）"
  exit 0
fi
